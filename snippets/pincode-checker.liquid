<style>
.pincode-wrapper {
  max-width: 450px;
  margin: 12px 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* HEADING MOVED OUTSIDE */
.pincode_header {
  font-size: 18px;
  margin-bottom: 12px;
  color: #1a1a1a;
  font-weight: 700;
  padding-left: 2px; /* Subtle nudge to match card alignment text precisely */
}
@media screen and (max-width: 749px) {
  .pincode_header{
    font-size: 16px !important;
  }
}

/* CARD CONTAINER */
.pincode-card {
  background: #f8f8f8;
  border-radius: 12px;
  padding: 10px 15px;
  box-sizing: border-box;
}

.pincode-flex-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 14px;
}

.pincode-container {
  flex-grow: 1;
  position: relative;
  display: flex;
  align-items: flex-end;
}

/* INPUT FIELD (Bottom border only) */
#pincodeVal {
  width: 100%;
  height: 40px;
  padding: 0 90px 4px 0; /* space for button */
  border: none;
  border-bottom: 1px solid #757575;
  background: transparent;
  font-size: 14px;
  color: #1a1a1a;
  border-radius: 0;
}

#pincodeVal:focus-visible {
  outline: none;
  border-bottom-color: #52ad4d;
}

/* BUTTON INSIDE INPUT */
#checkButton {
  position: absolute;
  right: 0;
  bottom: 6px;
  height: 32px;
  padding: 0 14px;
  background: #52ad4d;
  color: #ffffff;
  border: none;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.5px;
  cursor: pointer;
}

/* TRUCK ICON ALIGNMENT */
.pincode-truck-icon {
  display: flex;
  align-items: center;
  color: #1a1a1a;
  margin-bottom: 6px;
}

.loading_icon {
  display: none;
  margin-top: 10px;
}

.delivery-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.delivery-row .pincode-truck-icon {
  margin: 2px 0 0;
}

#messageContainer {
  margin-top: 0;
  font-size: 13px;
  font-weight: 600;
}

/* MOBILE */
@media only screen and (max-width: 600px) {
  .pincode-wrapper {
    width: 100%;
  }
  #pincodeVal {
    font-size: 16px;
    padding-right: 80px;
  }
  #checkButton {
    font-size: 11px;
    height: 28px;
    padding: 0 12px;
  }
}
</style>

<div class="pincode-wrapper">
  <div class="pincode_header">
    Delivery
  </div>

  <div class="pincode-card">
    <div class="delivery-row">
      <div class="pincode-truck-icon">
        <svg width="21" height="14" viewBox="0 0 21 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.5 9C5.07633 8.99988 5.63499 9.19889 6.08145 9.56335C6.52791 9.9278 6.83473 10.4353 6.95 11H14V1H3C2.46957 1 1.96086 1.21071 1.58579 1.58579C1.21071 1.96086 1 2.46957 1 3V11H2.05C2.16527 10.4353 2.47209 9.9278 2.91855 9.56335C3.36501 9.19889 3.92367 8.99988 4.5 9ZM4.5 14C3.92367 14.0001 3.36501 13.8011 2.91855 13.4367C2.47209 13.0722 2.16527 12.5647 2.05 12H0V3C0 2.20435 0.31607 1.44129 0.87868 0.87868C1.44129 0.316071 2.20435 0 3 0H14C14.2652 0 14.5196 0.105357 14.7071 0.292893C14.8946 0.48043 15 0.734784 15 1V3H18L21 7V12H18.95C18.8352 12.5651 18.5286 13.0732 18.0821 13.4382C17.6356 13.8031 17.0767 14.0025 16.5 14.0025C15.9233 14.0025 15.3644 13.8031 14.9179 13.4382C14.4714 13.0732 14.1648 12.5651 14.05 12H6.95C6.83473 12.5647 6.52791 13.0722 6.08145 13.4367C5.63499 13.8011 5.07633 14.0001 4.5 14ZM4.5 10C4.10218 10 3.72064 10.158 3.43934 10.4393C3.15804 10.7206 3 11.1022 3 11.5C3 11.8978 3.15804 12.2794 3.43934 12.5607C3.72064 12.842 4.10218 13 4.5 13C4.89782 13 5.27936 12.842 5.56066 12.5607C5.84196 12.2794 6 11.8978 6 11.5C6 11.1022 5.84196 10.7206 5.56066 10.4393C5.27936 10.158 4.89782 10 4.5 10ZM16.5 9C17.0763 8.99988 17.635 9.19889 18.0815 9.56335C18.5279 9.9278 18.8347 10.4353 18.95 11H20V7.32L19.76 7H15V9.5C15.42 9.19 15.94 9 16.5 9ZM16.5 10C16.1022 10 15.7206 10.158 15.4393 10.4393C15.158 10.7206 15 11.1022 15 11.5C15 11.8978 15.158 12.2794 15.4393 12.5607C15.7206 12.842 16.1022 13 16.5 13C16.8978 13 17.2794 12.842 17.5607 12.5607C17.842 12.2794 18 11.8978 18 11.5C18 11.1022 17.842 10.7206 17.5607 10.4393C17.2794 10.158 16.8978 10 16.5 10ZM15 4V6H19L17.5 4H15Z" fill="black"/>
        </svg>
      </div>
      <div id="messageContainer"></div>
    </div>
    {% comment %}
      ZIP code box removed for now (26 Oct). Dates show automatically for every shopper.
      To bring it back, restore the previous version of this file from the theme's file history.
    {% endcomment %}
  </div>
</div>

<script>
(function () {
  /* ── Delivery window: 2–7 business days, counted in US Eastern time.
     Weekends and major US carrier holidays are skipped.
     Shown automatically to every shopper. ── */
  var MIN_DAYS = 2;
  var MAX_DAYS = 7;
  var HOLIDAYS = [
    '2026-11-26', '2026-12-25',
    '2027-01-01', '2027-05-31', '2027-07-05', '2027-09-06', '2027-11-25', '2027-12-24'
  ];

  function easternToday() {
    var parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit'
    }).formatToParts(new Date());
    var get = function (type) {
      for (var i = 0; i < parts.length; i++) if (parts[i].type === type) return parseInt(parts[i].value, 10);
    };
    return new Date(get('year'), get('month') - 1, get('day'), 12, 0, 0);
  }

  function isoDate(d) {
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return d.getFullYear() + '-' + m + '-' + day;
  }

  function addBusinessDays(date, days) {
    var result = new Date(date);
    var added = 0;
    while (added < days) {
      result.setDate(result.getDate() + 1);
      var dow = result.getDay();
      if (dow !== 0 && dow !== 6 && HOLIDAYS.indexOf(isoDate(result)) === -1) added++;
    }
    return result;
  }

  function deliveryHTML(zip) {
    var today = easternToday();
    var opts = { weekday: 'short', month: 'short', day: 'numeric' };
    var earliest = addBusinessDays(today, MIN_DAYS).toLocaleDateString('en-US', opts);
    var latest = addBusinessDays(today, MAX_DAYS).toLocaleDateString('en-US', opts);
    return '<span style="color: #52ad4d;">Free delivery</span> ' +
      '<span style="color: #1a1a1a; font-weight: 500;">| Order today, get it ' + earliest + ' – ' + latest + '</span>' +
      '<div style="margin-top: 6px; font-size: 12px; color: #555; font-weight: 400;">' +
        (zip ? 'Delivering to ZIP ' + zip + '. ' : '') +
        'Tracking details will be shared once your order is placed.' +
      '</div>';
  }

  function init() {
    var checkButton = document.getElementById('checkButton');
    var pincodeVal = document.getElementById('pincodeVal');
    var messageContainer = document.getElementById('messageContainer');
    if (!messageContainer) return;

    /* Show the delivery window straight away */
    messageContainer.style.color = '';
    messageContainer.innerHTML = deliveryHTML('');

    /* ZIP box is currently removed; the code below only runs if it is added back */
    if (!checkButton || !pincodeVal) return;

    /* Allow only numbers */
    pincodeVal.addEventListener('input', function () {
      this.value = this.value.replace(/[^0-9]/g, '');
    });

    /* Submit on Enter key */
    pincodeVal.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') checkButton.click();
    });

    checkButton.addEventListener('click', function (e) {
      e.preventDefault();
      var enteredZip = pincodeVal.value.trim();
      var usZipRegex = /^(0[0-9]{4}|[1-9][0-9]{4})$/;
      var numericZip = parseInt(enteredZip, 10);

      if (!usZipRegex.test(enteredZip) || numericZip < 501 || numericZip > 99950) {
        messageContainer.innerHTML = 'Please enter a valid 5-digit US ZIP code.';
        messageContainer.style.color = 'red';
        return;
      }

      messageContainer.style.color = '';
      messageContainer.innerHTML = deliveryHTML(enteredZip);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
