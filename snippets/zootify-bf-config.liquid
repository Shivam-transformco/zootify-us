{% doc %}
  Supplies one schedule and campaign configuration to the storefront.
{% enddoc %}
  {{ 'zootify-black-friday.css' | asset_url | stylesheet_tag }}
  {%- if settings.zbf_font_source == 'custom' and settings.zbf_custom_font != blank -%}
    {% style %}{{ settings.zbf_custom_font | font_face: font_display: 'swap' }}{% endstyle %}
  {%- endif -%}
  {% style %}
    :root {
      {% if settings.zbf_font_source == 'custom' %}--zbf-font: {{ settings.zbf_custom_font.family }}, {{ settings.zbf_custom_font.fallback_families }};{% else %}--zbf-font: var(--font-body--family);{% endif %}
      --zbf-background: {{ settings.zbf_pdp_background }};
      --zbf-text: {{ settings.zbf_pdp_text }};
      --zbf-accent: {{ settings.zbf_pdp_accent }};
      --zbf-secondary: {{ settings.zbf_pdp_secondary_color }};
      --zbf-border: {{ settings.zbf_pdp_border }};
      --zbf-radius: {{ settings.zbf_pdp_radius }}px;
      --zbf-align: {{ settings.zbf_pdp_alignment }};
      --zbf-heading-size: {{ settings.zbf_pdp_heading_size }}px;
      --zbf-heading-size-mobile: {{ settings.zbf_pdp_heading_size_mobile }}px;
      --zbf-heading-weight: {{ settings.zbf_pdp_heading_weight }};
      --zbf-eyebrow-size: {{ settings.zbf_pdp_eyebrow_size }}px;
      --zbf-eyebrow-size-mobile: {{ settings.zbf_pdp_eyebrow_size_mobile }}px;
      --zbf-secondary-size: {{ settings.zbf_pdp_secondary_size }}px;
      --zbf-secondary-size-mobile: {{ settings.zbf_pdp_secondary_size_mobile }}px;
      --zbf-pdp-padding: {{ settings.zbf_pdp_padding }}px;
      --zbf-pdp-padding-mobile: {{ settings.zbf_pdp_padding_mobile }}px;
      --zbf-space-top: {{ settings.zbf_pdp_space_top }}px;
      --zbf-space-bottom: {{ settings.zbf_pdp_space_bottom }}px;
      --zbf-space-top-mobile: {{ settings.zbf_pdp_space_top_mobile }}px;
      --zbf-space-bottom-mobile: {{ settings.zbf_pdp_space_bottom_mobile }}px;
      --zbf-timer-space: {{ settings.zbf_timer_space }}px;
      --zbf-timer-size: {{ settings.zbf_timer_size }}px;
      --zbf-timer-size-mobile: {{ settings.zbf_timer_size_mobile }}px;
      --zbf-timer-text: {{ settings.zbf_timer_text }};
      --zbf-timer-digits: {{ settings.zbf_timer_digits }};
      --zbf-timer-weight: {{ settings.zbf_timer_weight }};
      --zbf-timer-accent: {{ settings.zbf_timer_accent }};
      --zbf-timer-align: {{ settings.zbf_timer_alignment }};
      --zbf-timer-panel-background: {{ settings.zbf_timer_panel_background }};
      --zbf-timer-cell-background: {{ settings.zbf_timer_cell_background }};
      --zbf-timer-cell-border: {{ settings.zbf_timer_cell_border }};
      --zbf-timer-digit-size: {{ settings.zbf_timer_digit_size }}px;
      --zbf-timer-digit-size-mobile: {{ settings.zbf_timer_digit_size_mobile }}px;
      --zbf-timer-cell-radius: {{ settings.zbf_timer_cell_radius }}px;
    }
  {% endstyle %}
  <script type="application/json" id="zootify-bf-config">
    {
      "enabled": {{ settings.zbf_enabled | json }},
      "cartEnabled": {{ settings.zbf_cart_enabled | json }},
      "offerMode": {{ settings.zbf_offer_mode | default: "legacy" | json }},
      "startDate": {{ settings.zbf_start_date | json }},
      "startTime": {{ settings.zbf_start_time | json }},
      "endDate": {{ settings.zbf_close_date | default: '2026-12-01' | json }},
      "endTime": {{ settings.zbf_close_time | default: '00:00' | json }},
      "timezone": {{ settings.zbf_timezone | json }},
      "releaseReady": {{ settings.zbf_native_ready | json }},
      "testMode": {{ settings.zbf_internal_test_mode | json }},
      "unpublishedTheme": {% if theme.role == 'unpublished' %}true{% else %}false{% endif %},
      "designMode": {{ request.design_mode | json }},
      "previewPhase": {% if request.design_mode %}{{ settings.zbf_preview_phase | json }}{% else %}"schedule"{% endif %},
      "customer": { "loggedIn": {% if customer %}true{% else %}false{% endif %}, "ordersCount": {% if customer %}{{ customer.orders_count | json }}{% else %}null{% endif %} },
      "codes": {
        "flat25": {{ settings.zbf_code_flat25 | default: "BF25" | json }},
        "b2g1": {{ settings.zbf_code_b2g1 | json }},
        "tiered": "",
        "bf30": {{ settings.zbf_code_bf30 | default: 'BF30' | json }},
        "bf20": {{ settings.zbf_code_bf20 | default: 'BF20' | json }},
        "bf10": {{ settings.zbf_code_bf10 | default: 'BF10' | json }},
        "welcome": {{ settings.zbf_code_welcome | json }},
        "regular": {{ settings.zp_discount_code | json }}
      },
      "labels": {
        "configure": {{ 'zootify_bf.countdown.configure' | t | json }}, "reminderEnded": {{ 'zootify_bf.countdown.reminder_ended' | t | json }},
        "starts": {{ settings.zbf_starts_label | json }}, "ends": {{ settings.zbf_ends_label | json }},
        "startsCompact": {{ settings.zbf_starts_compact | json }}, "endsCompact": {{ settings.zbf_ends_compact | json }},
        "coming": {{ 'zootify_bf.countdown.coming' | t | json }}, "live": {{ 'zootify_bf.countdown.live' | t | json }}, "ended": {{ 'zootify_bf.countdown.ended' | t | json }},
        "day": {{ 'zootify_bf.countdown.day' | t | json }}, "days": {{ 'zootify_bf.countdown.days' | t | json }},
        "hours": {{ 'zootify_bf.countdown.hours' | t | json }}, "minutes": {{ 'zootify_bf.countdown.minutes' | t | json }}, "seconds": {{ 'zootify_bf.countdown.seconds' | t | json }},
        "dayShort": {{ 'zootify_bf.countdown.day_short' | t | json }}, "hourShort": {{ 'zootify_bf.countdown.hour_short' | t | json }}, "minuteShort": {{ 'zootify_bf.countdown.minute_short' | t | json }}, "secondShort": {{ 'zootify_bf.countdown.second_short' | t | json }}
      }
    }
  </script>
  <script src="{{ 'zootify-black-friday.js' | asset_url }}" defer="defer"></script>
