{%- doc -%}
  Responsive Black Friday product-grid card with an editable native CTA.
  @param {object} promo_settings - Promo block settings.
  @param {string} [button_markup] - Rendered campaign button block.
  @param {string} [destination] - Sale collection or draft preview URL.
  @param {string} [display_mode] - Editorial layout fallback.
{%- enddoc -%}
{%- liquid
  assign p = promo_settings
  assign desktop_image = p.zbf_promo_image | default: p.zbf_promo_image_mobile
  assign mobile_image = p.zbf_promo_image_mobile | default: desktop_image
  assign image_enabled = false
  if p.zbf_promo_background_mode == 'image' and desktop_image != blank
    assign image_enabled = true
  endif
  assign heading = p.zbf_promo_heading | strip
  assign accent = p.zbf_promo_accent_text | strip
  assign eyebrow = p.zbf_promo_eyebrow | strip
  assign copy = p.zbf_promo_copy | strip
  assign family = settings.type_heading_font
  case p.zbf_promo_font
    when 'body'
      assign family = settings.type_body_font
    when 'accent'
      assign family = settings.type_accent_font
    when 'custom'
      assign family = p.zbf_promo_custom_font
  endcase
  assign weight_font = family | font_modify: 'weight', p.zbf_promo_weight
  assign weight_font = weight_font | default: family
  assign image_description = p.zbf_promo_image_alt | default: ''
  assign shop_label = 'zootify_bf.accessibility.shop_sale' | t
-%}
{% style %}{{ weight_font | font_face: font_display: 'swap' }}{% endstyle %}
<zbf-collection-promo
  class="zbf-promo zbf-promo--refined{% unless p.zbf_promo_composition == 'custom' %} zbf-promo--balanced{% endunless %} color-{{ p.zbf_promo_scheme }} zbf-promo--{{ p.zbf_promo_layout }}{% if image_enabled %} zbf-promo--with-image{% endif %}{% if display_mode == 'outside' %} zbf-promo--outside{% endif %}"
  data-after-desktop="{{ p.zbf_promo_after }}" data-after-mobile="{{ p.zbf_promo_after_mobile }}" data-first-row="{{ p.zbf_promo_first_row }}"
  style="
    --zbf-promo-bg: {{ p.zbf_promo_background | default: '#101010' }};
    --zbf-promo-text: {{ p.zbf_promo_color | default: '#FFFFFF' }};
    --zbf-promo-accent: {{ p.zbf_promo_accent_color | default: '#CE423B' }};
    --zbf-promo-border: {{ p.zbf_promo_border }};
    --zbf-promo-border-width: {{ p.zbf_promo_border_width }}px;
    --zbf-promo-radius: {{ p.zbf_promo_radius }}px;
    --zbf-promo-fit: {{ p.zbf_promo_fit }};
    --zbf-promo-focus-desktop: {{ desktop_image.presentation.focal_point | default: '50% 50%' }};
    --zbf-promo-focus-mobile: {{ mobile_image.presentation.focal_point | default: '50% 50%' }};
    --zbf-promo-overlay: {{ p.zbf_promo_overlay_color | default: '#000000' }};
    --zbf-promo-overlay-alpha: {{ p.zbf_promo_overlay_opacity | divided_by: 100.0 }};
    --zbf-promo-font: {{ family.family | escape }}, {{ family.fallback_families }};
    --zbf-promo-font-style: {{ family.style }};
    --zbf-promo-weight: {{ p.zbf_promo_weight }};
    --zbf-promo-heading-desktop: {{ p.zbf_promo_heading_size }}px;
    --zbf-promo-heading-mobile: {{ p.zbf_promo_heading_mobile }}px;
    --zbf-promo-copy-desktop: {{ p.zbf_promo_copy_size }}px;
    --zbf-promo-copy-mobile: {{ p.zbf_promo_copy_mobile }}px;
    --zbf-promo-pad-desktop: {{ p.zbf_promo_padding }}px;
    --zbf-promo-pad-mobile: {{ p.zbf_promo_padding_mobile }}px;
    --zbf-promo-gap-desktop: {{ p.zbf_promo_gap }}px;
    --zbf-promo-gap-mobile: {{ p.zbf_promo_gap_mobile }}px;
    --zbf-promo-cta-gap-desktop: {{ p.zbf_promo_cta_gap | default: 20 }}px;
    --zbf-promo-cta-gap-mobile: {{ p.zbf_promo_cta_gap_mobile | default: 18 }}px;
    --zbf-promo-vertical-desktop: {{ p.zbf_promo_vertical }};
    --zbf-promo-vertical-mobile: {{ p.zbf_promo_vertical_mobile }};
    --zbf-promo-height-desktop: {{ p.zbf_promo_min_height }}px;
    --zbf-promo-height-mobile: {{ p.zbf_promo_min_height_mobile }}px;
    --zbf-promo-align-desktop: {{ p.zbf_promo_align }};
    --zbf-promo-align-mobile: {{ p.zbf_promo_align_mobile }};
    --zbf-promo-footer-bg: {{ p.zbf_promo_footer_color | default: '#F7F7F7' }};
    --zbf-promo-footer-border: {{ p.zbf_promo_footer_border | default: '#E6E6E6' }};
    --zbf-promo-footer-height-desktop: {{ p.zbf_promo_footer_height }}px;
    --zbf-promo-footer-height-mobile: {{ p.zbf_promo_footer_height_mobile }}px;
    --zbf-promo-footer-pad-desktop: {% if p.zbf_promo_match_alignment %}{{ p.zbf_promo_padding }}{% else %}{{ p.zbf_promo_footer_padding }}{% endif %}px;
    --zbf-promo-footer-pad-mobile: {% if p.zbf_promo_match_alignment %}{{ p.zbf_promo_padding_mobile }}{% else %}{{ p.zbf_promo_footer_padding_mobile }}{% endif %}px;
  ">
  <div class="zbf-promo__top">
    {%- if image_enabled -%}
      <picture class="zbf-promo__image-wrap">
        {%- if p.zbf_promo_image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 320 }} 320w, {{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="{% if p.zbf_promo_mobile_layout == 'tile' %}50vw{% else %}100vw{% endif %}">
        {%- endif -%}
        {{ desktop_image | image_url: width: 1800 | image_tag: widths: '320, 480, 750, 1100, 1500, 1800', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: image_description, class: 'zbf-promo__image' }}
      </picture>
      <div class="zbf-promo__overlay" aria-hidden="true"></div>
    {%- endif -%}
    {%- if p.zbf_promo_image_link and destination != blank -%}
      <a class="zbf-promo__top-link" href="{{ destination | escape }}" aria-label="{{ shop_label | escape }}"{% if button_markup != blank %} tabindex="-1" aria-hidden="true"{% endif %}></a>
    {%- endif -%}
    <div class="zbf-promo__headline">
      <div class="zbf-promo__intro">
        {%- if eyebrow != blank -%}<p class="zbf-promo__eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
        {%- if heading != blank or accent != blank -%}<h3 class="zbf-promo__title"><span>{{ heading | escape }}</span>{% if accent != blank %}<span class="zbf-promo__accent">{{ accent | escape }}</span>{% endif %}</h3>{%- endif -%}
        {%- if copy != blank -%}<p class="zbf-promo__subtext">{{ copy | escape | newline_to_br }}</p>{%- endif -%}
      </div>
      {%- unless p.zbf_promo_footer_visible -%}{%- if button_markup != blank -%}<div class="zbf-promo__cta">{{ button_markup }}</div>{%- endif -%}{%- endunless -%}
    </div>
  </div>
  {%- if p.zbf_promo_footer_visible and button_markup != blank -%}<div class="zbf-promo__footer">{{ button_markup }}</div>{%- endif -%}
</zbf-collection-promo>
{% stylesheet %}
  .zbf-promo-item { min-width: 0; grid-column: auto; list-style: none; align-self: stretch; isolation: isolate; }
  .zbf-promo-item--full { grid-column: 1 / -1; }
  .zbf-promo--refined, .zbf-promo--refined * { box-sizing: border-box; }
  .zbf-promo--refined {
    display: flex; flex-direction: column; width: 100%; height: 100%; min-width: 0;
    border: var(--zbf-promo-border-width) solid var(--zbf-promo-border);
    border-radius: var(--zbf-promo-radius); overflow: clip; background: var(--zbf-promo-bg);
    --zbf-active-pad: var(--zbf-promo-pad-mobile); --zbf-active-gap: var(--zbf-promo-gap-mobile);
    --zbf-active-align: var(--zbf-promo-align-mobile); --zbf-active-height: var(--zbf-promo-height-mobile);
    --zbf-active-position: var(--zbf-promo-vertical-mobile); --zbf-active-cta-gap: var(--zbf-promo-cta-gap-mobile);
  }
  .zbf-promo--refined .zbf-promo__top {
    position: relative; isolation: isolate; display: flex; flex: 1 1 auto; min-height: var(--zbf-active-height); min-width: 0;
    background: linear-gradient(145deg, rgb(255 255 255 / .035), transparent 70%), var(--zbf-promo-bg); color: var(--zbf-promo-text);
  }
  .zbf-promo--refined .zbf-promo__image-wrap, .zbf-promo--refined .zbf-promo__overlay, .zbf-promo--refined .zbf-promo__top-link { position: absolute; inset: 0; }
  .zbf-promo--refined .zbf-promo__image-wrap { display: block; z-index: 0; pointer-events: none; }
  .zbf-promo--refined .zbf-promo__image { display: block; width: 100%; height: 100%; object-fit: var(--zbf-promo-fit); object-position: var(--zbf-promo-focus-mobile); }
  .zbf-promo--refined .zbf-promo__overlay { z-index: 1; pointer-events: none; background: var(--zbf-promo-overlay); opacity: var(--zbf-promo-overlay-alpha); }
  .zbf-promo--refined .zbf-promo__top-link { z-index: 2; }
  .zbf-promo--refined .zbf-promo__headline {
    position: relative; z-index: 3; display: flex; flex-direction: column; justify-content: var(--zbf-active-position, center);
    flex: 1 1 auto; width: 100%; min-width: 0; padding: var(--zbf-active-pad); gap: var(--zbf-active-cta-gap, 20px);
    text-align: var(--zbf-active-align); pointer-events: none;
  }
  .zbf-promo--balanced .zbf-promo__headline { justify-content: center; padding: max(16px, var(--zbf-active-pad)); }
  .zbf-promo--refined .zbf-promo__intro { display: flex; flex-direction: column; gap: var(--zbf-active-gap); min-width: 0; width: 100%; }
  .zbf-promo--refined .zbf-promo__eyebrow { margin: 0; color: var(--zbf-promo-text); opacity: .72; font-family: var(--font-body--family); font-size: 10px; line-height: 1.5; font-weight: 500; letter-spacing: .09em; text-transform: uppercase; overflow-wrap: normal; }
  .zbf-promo--refined .zbf-promo__title { display: block; margin: 0; width: 100%; max-width: 100%; color: var(--zbf-promo-text); font-family: var(--zbf-promo-font); font-style: var(--zbf-promo-font-style, normal); font-weight: var(--zbf-promo-weight); font-size: var(--zbf-promo-heading-mobile); line-height: 1.12; letter-spacing: -.035em; white-space: normal; overflow-wrap: normal; word-break: normal; text-wrap: balance; }
  .zbf-promo--refined .zbf-promo__title > span { display: block; }
  .zbf-promo--refined .zbf-promo__accent { color: var(--zbf-promo-accent); margin-top: .05em; }
  .zbf-promo--refined .zbf-promo__subtext { margin: 2px 0 0; color: var(--zbf-promo-text); opacity: .78; font-family: var(--font-body--family); font-size: var(--zbf-promo-copy-mobile); font-weight: 400; line-height: 1.5; overflow-wrap: anywhere; }
  .zbf-promo--refined .zbf-promo__cta { width: 100%; min-width: 0; max-width: 100%; margin: 0; pointer-events: auto; }
  .zbf-promo--refined .zbf-promo__cta > .zbf-campaign-button, .zbf-promo--refined .zbf-promo__footer > .zbf-campaign-button { display: flex; width: 100%; min-width: 0; max-width: 100%; margin-block-start: var(--zbf-cbtn-top-mobile, 0px); padding-inline: min(var(--zbf-cbtn-inset-mobile, 0px), 20%); justify-content: var(--zbf-cbtn-align-mobile, flex-start); }
  .zbf-promo--refined .zbf-campaign-button > a.zbf-campaign-button__link.button { display: inline-flex; flex: 0 1 auto; justify-content: center; align-items: center; width: var(--zbf-cbtn-width-mobile, fit-content); max-width: 100%; min-width: 0; min-height: var(--zbf-cbtn-height-mobile); height: auto; margin: 0; padding: var(--zbf-cbtn-pad-y-mobile) var(--zbf-cbtn-pad-x-mobile); font-size: var(--zbf-cbtn-size-mobile); font-weight: var(--zbf-cbtn-weight-mobile, 700); line-height: 1.25; letter-spacing: .025em; white-space: normal; word-break: normal; overflow-wrap: normal; text-align: center; text-decoration: none; text-transform: uppercase; box-shadow: none; border-radius: var(--zbf-cbtn-radius, 3px); pointer-events: auto; }
  .zbf-promo--refined .zbf-campaign-button > a.zbf-campaign-button__link.button::before, .zbf-promo--refined .zbf-campaign-button > a.zbf-campaign-button__link.button::after { content: none; }
  .zbf-promo--refined .zbf-promo__footer { display: flex; flex-direction: column; justify-content: center; min-width: 0; min-height: var(--zbf-promo-footer-height-mobile); padding: 12px var(--zbf-promo-footer-pad-mobile); background: var(--zbf-promo-footer-bg); border-top: 1px solid var(--zbf-promo-footer-border); }
  .zbf-promo--refined a:focus-visible { outline: 2px solid var(--zbf-promo-accent); outline-offset: 3px; }
  .zbf-promo--refined .zbf-promo__top-link:focus-visible { outline-offset: -4px; }
  .product-grid[product-grid-view='zoom-out'] > .zbf-promo-item { display: none; }
  .zbf-promo-outside { grid-column: 1 / -1; margin: 20px var(--page-margin); }
  @media (max-width: 749px) {
    .zbf-promo-item--mobile-tile { grid-column: auto; } .zbf-promo-item--mobile-full { grid-column: 1 / -1; }
    .zbf-promo--balanced .zbf-campaign-button > a.zbf-campaign-button__link.button { min-height: max(36px, var(--zbf-cbtn-height-mobile)); font-size: max(12px, var(--zbf-cbtn-size-mobile)); }
    .zbf-promo-item--mobile-tile .zbf-promo--refined .zbf-promo__title { font-size: min(var(--zbf-promo-heading-mobile), 6vw); }
  }
  @media (min-width: 750px) {
    .zbf-promo-item--tile { grid-column: auto; }
    .zbf-promo--refined { --zbf-active-pad: var(--zbf-promo-pad-desktop); --zbf-active-gap: var(--zbf-promo-gap-desktop); --zbf-active-align: var(--zbf-promo-align-desktop); --zbf-active-height: var(--zbf-promo-height-desktop); --zbf-active-position: var(--zbf-promo-vertical-desktop); --zbf-active-cta-gap: var(--zbf-promo-cta-gap-desktop); }
    .zbf-promo--refined .zbf-promo__image { object-position: var(--zbf-promo-focus-desktop); }
    .zbf-promo--refined .zbf-promo__title { font-size: var(--zbf-promo-heading-desktop); }
    .zbf-promo--refined .zbf-promo__subtext { font-size: var(--zbf-promo-copy-desktop); }
    .zbf-promo--refined .zbf-promo__cta > .zbf-campaign-button, .zbf-promo--refined .zbf-promo__footer > .zbf-campaign-button { margin-block-start: var(--zbf-cbtn-top-desktop, 0px); padding-inline: min(var(--zbf-cbtn-inset-desktop, 0px), 20%); justify-content: var(--zbf-cbtn-align-desktop, flex-start); }
    .zbf-promo--refined .zbf-campaign-button > a.zbf-campaign-button__link.button { width: var(--zbf-cbtn-width-desktop, fit-content); min-height: var(--zbf-cbtn-height-desktop); padding: var(--zbf-cbtn-pad-y-desktop) var(--zbf-cbtn-pad-x-desktop); font-size: var(--zbf-cbtn-size-desktop); font-weight: var(--zbf-cbtn-weight-desktop, 700); }
    .zbf-promo--refined .zbf-promo__footer { min-height: var(--zbf-promo-footer-height-desktop); padding-inline: var(--zbf-promo-footer-pad-desktop); }
  }
{% endstylesheet %}
