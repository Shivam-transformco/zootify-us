{% comment %}
  Email signup popup (audit #5). Signups are saved as Shopify customers tagged
  "newsletter" (email marketing consent) plus "popup-welcome10", so they can be
  used in Shopify Email or any email app later.
  Shows once, 2 seconds after the page opens (or earlier on 40% scroll / leaving the page on desktop).
  Closing it hides it for 14 days; signing up hides it for good.
  To change the offer, edit the code below and the WELCOME10 discount in Shopify.

  PAUSE SWITCH: while the shop metafield custom.signup_popup_paused is true, customers
  never see the popup. To test it, open any page with ?popup=test added to the URL
  (e.g. https://us.zootify.com/?popup=test). Test mode lasts for that browser tab session
  and ignores the "closed / already signed up" memory, so it shows every time.
  To go live: set the metafield to false (Settings > Custom data > Shop) or ask Claude.
{% endcomment %}
{%- liquid
  assign zt_paused = false
  if shop.metafields.custom.signup_popup_paused.value == true
    assign zt_paused = true
  endif
  assign zt_code = 'WELCOME10'
  assign zt_show = true
  if customer or request.design_mode
    assign zt_show = false
  endif
  if request.page_type == 'cart' or request.page_type == 'customers/login' or request.page_type == 'customers/register' or request.page_type == 'customers/account' or request.page_type == 'password'
    assign zt_show = false
  endif
-%}
{%- if zt_show -%}
<div class="zt-pop" id="zt-pop" data-zt-paused="{{ zt_paused }}" hidden>
  <div class="zt-pop__overlay" data-zt-close></div>
  <div class="zt-pop__box" role="dialog" aria-modal="true" aria-labelledby="zt-pop-title">
    <button type="button" class="zt-pop__x" data-zt-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    {%- form 'customer', id: 'zt-pop-form', class: 'zt-pop__form' -%}
      {%- liquid
        assign zt_done = false
        if form.posted_successfully?
          assign zt_done = true
        endif
        if form.errors
          for zt_field in form.errors
            assign zt_err = form.errors.messages[zt_field] | append: '' | downcase
            if zt_err contains 'taken' or zt_err contains 'already'
              assign zt_done = true
            endif
          endfor
        endif
      -%}
      <div class="zt-pop__eyebrow">ZOOTIFY</div>
      {%- if zt_done -%}
        <h2 class="zt-pop__title" id="zt-pop-title">You're in.</h2>
        <p class="zt-pop__text">Here's 10% off your first order:</p>
        <div class="zt-pop__code">
          <span id="zt-pop-code">{{ zt_code }}</span>
          <button type="button" class="zt-pop__copy" data-zt-copy>Copy</button>
        </div>
        <a class="zt-pop__btn" href="/discount/{{ zt_code }}?redirect=/collections/new-arrivals">Shop now – code applied</a>
        <p class="zt-pop__fine">One use per customer. Can't be combined with other product or order discounts.</p>
      {%- else -%}
        <h2 class="zt-pop__title" id="zt-pop-title">Get 10% off your first order</h2>
        <p class="zt-pop__text">Join the ZOOTIFY list for early access to new drops and colours, plus 10% off your first order.</p>
        <input type="hidden" name="contact[tags]" value="newsletter,popup-welcome10">
        <label class="zt-pop__label" for="zt-pop-email">Email address</label>
        <input class="zt-pop__input" id="zt-pop-email" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        {%- if form.errors -%}
          <p class="zt-pop__error" role="alert">Please enter a valid email address.</p>
        {%- endif -%}
        <button type="submit" class="zt-pop__btn">Unlock 10% off</button>
        <button type="button" class="zt-pop__skip" data-zt-close>No thanks</button>
        <p class="zt-pop__fine">No spam. Unsubscribe anytime.</p>
      {%- endif -%}
      <span hidden data-zt-state="{% if zt_done %}done{% elsif form.errors %}error{% else %}new{% endif %}"></span>
    {%- endform -%}
  </div>
</div>

<style>
  .zt-pop[hidden]{display:none}
  .zt-pop{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;padding:16px}
  .zt-pop__overlay{position:absolute;inset:0;background:rgba(1,21,30,.55)}
  .zt-pop__box{position:relative;width:100%;max-width:420px;background:#fff;color:#01151E;border-radius:16px;padding:32px 28px 24px;box-shadow:0 20px 60px rgba(0,0,0,.25);text-align:center;animation:ztIn .25s ease-out}
  @keyframes ztIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .zt-pop__x{position:absolute;top:10px;right:10px;width:36px;height:36px;border:0;background:transparent;color:#01151E;cursor:pointer;border-radius:50%;display:flex;align-items:center;justify-content:center}
  .zt-pop__x:hover{background:#f2f2f2}
  .zt-pop__eyebrow{font-size:12px;letter-spacing:.2em;font-weight:700;color:#52ad4d;margin-bottom:8px}
  .zt-pop__title{font-size:24px;line-height:1.2;margin:0 0 10px;font-weight:700;color:#01151E}
  .zt-pop__text{font-size:14px;line-height:1.5;margin:0 0 18px;color:#3a4a52}
  .zt-pop__label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .zt-pop__input{width:100%;height:48px;border:1px solid #c9d0d4;border-radius:8px;padding:0 14px;font-size:16px;color:#01151E;background:#fff;box-sizing:border-box}
  .zt-pop__input:focus{outline:2px solid #6ac857;outline-offset:1px;border-color:#6ac857}
  .zt-pop__btn{display:flex;align-items:center;justify-content:center;width:100%;height:48px;margin-top:10px;border:0;border-radius:8px;background:#01151E;color:#6ac857;font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;cursor:pointer}
  .zt-pop__btn:hover{background:#000;color:#fff}
  .zt-pop__skip{margin-top:10px;border:0;background:none;color:#5b6670;font-size:13px;text-decoration:underline;cursor:pointer}
  .zt-pop__fine{font-size:11px;color:#7a868d;margin:10px 0 0}
  .zt-pop__error{color:#b3261e;font-size:13px;margin:8px 0 0}
  .zt-pop__code{display:flex;align-items:center;justify-content:space-between;gap:10px;border:2px dashed #6ac857;border-radius:8px;padding:10px 12px 10px 16px;font-size:20px;font-weight:700;letter-spacing:.12em}
  .zt-pop__copy{border:0;background:#eef8ec;color:#1f7a3a;border-radius:6px;padding:8px 12px;font-size:12px;font-weight:700;cursor:pointer;letter-spacing:.04em}
  @media (max-width:600px){
    .zt-pop{align-items:flex-end;padding:0}
    .zt-pop__box{max-width:none;border-radius:16px 16px 0 0;padding:28px 20px 20px}
    .zt-pop__title{font-size:21px}
  }
</style>

<script>
(function () {
  var pop = document.getElementById('zt-pop');
  if (!pop) return;
  var KEY = 'zt_signup_popup';
  var stateEl = pop.querySelector('[data-zt-state]');
  var state = stateEl ? stateEl.getAttribute('data-zt-state') : 'new';

  /* Pause switch: when paused, only show in test mode (?popup=test, remembered for this tab session) */
  var testMode = false;
  try {
    if (/[?&]popup=test\b/.test(window.location.search)) sessionStorage.setItem('zt_popup_test', '1');
    testMode = sessionStorage.getItem('zt_popup_test') === '1';
  } catch (e) {}
  if (pop.getAttribute('data-zt-paused') === 'true' && !testMode) return;

  function read() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; } }
  function write(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} }

  var lastFocus = null;
  function open() {
    if (!pop.hidden) return;
    lastFocus = document.activeElement;
    pop.hidden = false;
    var f = pop.querySelector('input[type=email], .zt-pop__btn');
    if (f) setTimeout(function () { f.focus(); }, 50);
    document.addEventListener('keydown', onKey);
  }
  function close() {
    pop.hidden = true;
    document.removeEventListener('keydown', onKey);
    var s = read();
    if (!s.subscribed) { s.dismissedAt = Date.now(); write(s); }
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  function onKey(e) { if (e.key === 'Escape') close(); }

  pop.querySelectorAll('[data-zt-close]').forEach(function (el) { el.addEventListener('click', close); });

  var copyBtn = pop.querySelector('[data-zt-copy]');
  if (copyBtn) copyBtn.addEventListener('click', function () {
    var code = document.getElementById('zt-pop-code').textContent.trim();
    try { navigator.clipboard.writeText(code); copyBtn.textContent = 'Copied'; } catch (e) {}
  });

  /* After submitting, the page reloads: show the result straight away */
  if (state === 'done') { var s1 = read(); s1.subscribed = true; write(s1); open(); return; }
  if (state === 'error') { open(); return; }

  var s = read();
  if (!testMode) {
    if (s.subscribed) return;
    if (s.dismissedAt && Date.now() - s.dismissedAt < 14 * 24 * 60 * 60 * 1000) return;
  }

  var fired = false;
  function trigger() {
    if (fired) return; fired = true;
    window.removeEventListener('scroll', onScroll);
    document.removeEventListener('mouseout', onLeave);
    open();
  }
  function onScroll() {
    var h = document.documentElement.scrollHeight - window.innerHeight;
    if (h > 0 && window.scrollY / h > 0.4) trigger();
  }
  function onLeave(e) { if (!e.relatedTarget && e.clientY <= 0) trigger(); }
  setTimeout(trigger, 2000);
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('mouseout', onLeave);
})();
</script>
{%- endif -%}
