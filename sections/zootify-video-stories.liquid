    queueNavigation() {
      if (this.navigationFrame) return;
      this.navigationFrame = requestAnimationFrame(() => {
        this.navigationFrame = null;
        if (this.abortController) {
          this.updateNavigation();
          this.reconcilePlayback();
        }
      });
    }

    updateNavigation() {
      const max = this.maxScroll();
      const position = Math.min(max, this.position());
      this.classList.toggle('has-overflow', max > 2);
      if (this.previousButton) this.previousButton.disabled = position <= 2;
      if (this.nextButton) this.nextButton.disabled = position >= max - 2;
      this.progress?.style.setProperty('--progress', String(max ? position / max : 1));
      let index = 0;
      if (max > 2 && position >= max - 2) index = this.cards.length - 1;
      else {
        let nearest = Infinity;
        this.cards.forEach((card, candidate) => {
          const distance = Math.abs(this.cardPosition(card) - position);
          if (distance < nearest) {
