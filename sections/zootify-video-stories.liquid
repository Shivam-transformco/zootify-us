    syncControls(state) {
      const playing = Boolean(state.phase === 'playing' && state.video && !state.video.paused && state.shouldPlay);
      const loading = state.phase === 'loading';
      const muted = state.video ? state.video.muted : true;
      state.card.classList.toggle('is-muted', muted);
      state.card.classList.toggle('is-playing', playing);
      state.card.classList.toggle('is-loading', loading);
