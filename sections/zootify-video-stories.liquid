{% liquid
  assign s = section.settings
  assign media_count = 0
  assign image_loading = 'lazy'
  if section.index == 1
    assign image_loading = 'eager'
  endif
%}
{% capture story_cards %}
  {% for block in section.blocks %}
    {% liquid
      assign b = block.settings
      assign has_video = false
      if b.media_type == 'video' and b.video != blank
        assign has_video = true
      endif
      assign cover = b.image
      if cover == blank and has_video
        assign cover = b.video.preview_image
      endif
      if cover == blank and b.product != blank
        assign cover = b.product.featured_image
      endif
      assign card_title = b.title
      if card_title == blank and b.product != blank
        assign card_title = b.product.title
      endif
      assign media_label = b.accessibility_label | default: card_title | default: s.heading | strip_html
      assign destination = b.link
      if destination == blank and b.product != blank
        assign destination = b.product.url
      endif
      assign show_card = false
      if has_video or cover != blank or request.design_mode
        assign show_card = true
      endif
    %}
    {% if show_card %}
      {% assign media_count = media_count | plus: 1 %}
      <li
        class="zms__card is-muted{% if has_video %} zms__card--video{% endif %}"
        data-zms-card
        data-block-id="{{ block.id }}"
        style="--zms-fit: {{ b.media_fit }}; --zms-position: {{ b.media_position }};"
        {{ block.shopify_attributes }}
      >
        <div class="zms__media">
          {% if cover != blank %}
            <picture data-zms-poster>
              {% if b.mobile_image != blank %}
                <source media="(max-width: 749px)" srcset="{{ b.mobile_image | image_url: width: 400 }} 400w, {{ b.mobile_image | image_url: width: 600 }} 600w, {{ b.mobile_image | image_url: width: 900 }} 900w" sizes="75vw" width="{{ b.mobile_image.width }}" height="{{ b.mobile_image.height }}">
              {% endif %}
              {{ cover | image_url: width: 1000 | image_tag: widths: '240, 360, 480, 640, 800, 1000', sizes: '(min-width: 1800px) 500px, (min-width: 900px) 30vw, (min-width: 500px) 48vw, 75vw', loading: image_loading, class: 'zms__image', alt: media_label }}
            </picture>
          {% else %}
            <div class="zms__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'zms__placeholder-svg' }}
              <span>{{ 'zootify_media_stories.add_media' | t }}</span>
            </div>
          {% endif %}
        </div>
        {% if has_video %}
          <template data-zms-video-template>
            {% capture video_markup %}{{ b.video | video_tag: image_size: '800x', preload: 'none', autoplay: false, muted: true, loop: s.loop, controls: false, class: 'zms__video' }}{% endcapture %}
            {% if b.captions_url != blank %}
              {% capture caption_track %}<track kind="captions" src="{{ b.captions_url | escape }}" srclang="{{ b.captions_language | default: 'en' | escape }}" label="{{ b.captions_label | default: 'English' | escape }}" default>{% endcapture %}
              {% assign caption_track = caption_track | append: '</video>' %}
              {% assign video_markup = video_markup | replace: '</video>', caption_track | replace: '<video ', '<video crossorigin="anonymous" ' %}
            {% endif %}
            {{ video_markup }}
          </template>
          <noscript>
            <div class="zms__native">{{ video_markup | replace: '<video ', '<video controls ' }}</div>
          </noscript>
          <button class="zms__icon-button zms__play" type="button" data-zms-play data-play-label="{{ 'zootify_media_stories.play' | t | escape }}: {{ media_label | escape }}" data-pause-label="{{ 'zootify_media_stories.pause' | t | escape }}: {{ media_label | escape }}" aria-label="{{ 'zootify_media_stories.play' | t | escape }}: {{ media_label | escape }}" aria-pressed="false">
            <svg class="zms__icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.6a1 1 0 0 1 1.5-.86l10 6.4a1 1 0 0 1 0 1.72l-10 6.4A1 1 0 0 1 8 18.4Z"/></svg>
            <svg class="zms__icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          </button>
          {% if s.show_sound %}
            <button class="zms__icon-button zms__mute" type="button" data-zms-mute data-mute-label="{{ 'zootify_media_stories.mute' | t | escape }}: {{ media_label | escape }}" data-unmute-label="{{ 'zootify_media_stories.unmute' | t | escape }}: {{ media_label | escape }}" aria-label="{{ 'zootify_media_stories.unmute' | t | escape }}: {{ media_label | escape }}" aria-pressed="false">
              <svg class="zms__icon-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18M10 5l3-2v6M5 9H3v6h4l6 5v-7M17 8a7 7 0 0 1 1.7 7M19.5 5a11 11 0 0 1 2 13"/></svg>
              <svg class="zms__icon-unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9h4l6-5v16l-6-5H3ZM17 8a6 6 0 0 1 0 8M20 5a10 10 0 0 1 0 14"/></svg>
            </button>
          {% endif %}
          <p class="zms__error" data-zms-error role="status" hidden>{{ 'zootify_media_stories.video_error' | t }}</p>
        {% endif %}
        {% if card_title != blank or b.caption != blank or destination != blank %}
          <div class="zms__caption{% if destination != blank %} zms__caption--linked{% endif %}">
            <div class="zms__copy">
              {% if card_title != blank %}<h3 class="zms__card-title">{{ card_title | escape }}</h3>{% endif %}
              {% if b.caption != blank %}<p class="zms__card-caption">{{ b.caption | escape }}</p>{% endif %}
            </div>
            {% if destination != blank %}
              <a class="zms__icon-button zms__product-link" href="{{ destination }}" aria-label="{{ 'zootify_media_stories.explore' | t | escape }}: {{ media_label | escape }}"{% if b.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </li>
    {% endif %}
  {% endfor %}
{% endcapture %}
{% if media_count > 0 or request.design_mode %}
  <zootify-media-stories
    id="ZootifyMediaStories-{{ section.id }}"
    class="zms{% if s.show_arrows %} zms--arrows{% endif %}{% if s.mobile_arrows %} zms--mobile-arrows{% endif %}"
    data-autoplay="{{ s.autoplay }}"
    data-loop="{{ s.loop }}"
    data-play-label="{{ 'zootify_media_stories.play' | t | escape }}"
    data-pause-label="{{ 'zootify_media_stories.pause' | t | escape }}"
    data-mute-label="{{ 'zootify_media_stories.mute' | t | escape }}"
    data-unmute-label="{{ 'zootify_media_stories.unmute' | t | escape }}"
    style="--zms-max-width: {{ s.max_width }}px; --zms-edge-d: {{ s.side_padding }}vw; --zms-edge-m: {{ s.side_padding_mobile }}px; --zms-per-view-d: {{ s.cards_desktop }}; --zms-per-view-m: {{ s.cards_mobile }}; --zms-gap-d: {{ s.gap }}px; --zms-gap-m: {{ s.gap_mobile }}px; --zms-ratio-d: {{ s.ratio }}; --zms-ratio-m: {{ s.ratio_mobile }}; --zms-radius-d: {{ s.radius }}px; --zms-radius-m: {{ s.radius_mobile }}px; --zms-top-d: {{ s.padding_top }}px; --zms-bottom-d: {{ s.padding_bottom }}px; --zms-top-m: {{ s.padding_top_mobile }}px; --zms-bottom-m: {{ s.padding_bottom_mobile }}px; --zms-heading-d: {{ s.heading_size }}px; --zms-heading-m: {{ s.heading_size_mobile }}px; --zms-heading-weight: {{ s.heading_weight }}; --zms-title-d: {{ s.title_size }}px; --zms-title-m: {{ s.title_size_mobile }}px; --zms-caption-d: {{ s.caption_size }}px; --zms-caption-m: {{ s.caption_size_mobile }}px; --zms-background: {{ s.background }}; --zms-text: {{ s.text_color }}; --zms-muted: {{ s.muted_color }}; --zms-card-background: {{ s.card_background }}; --zms-card-text: {{ s.card_text }}; --zms-card-muted: {{ s.card_text | color_modify: 'alpha', 0.8 }}; --zms-accent: {{ s.accent }}; --zms-control-background: {{ s.control_background | color_modify: 'alpha', 0.32 }}; --zms-control-color: {{ s.control_color }}; --zms-overlay: {{ s.overlay_opacity | divided_by: 100.0 }}; --zms-align: {{ s.alignment }};"
  >
    <div class="zms__header">
      <div class="zms__intro">
        {% if s.heading != blank %}<h2 id="ZootifyMediaHeading-{{ section.id }}" class="zms__heading">{{ s.heading }}</h2>{% endif %}
        {% if s.subheading != blank %}<p class="zms__subheading">{{ s.subheading | escape }}</p>{% endif %}
      </div>
      <div class="zms__navigation" aria-label="{{ 'zootify_media_stories.navigation' | t | escape }}">
        <button class="zms__nav-button" data-zms-prev type="button" disabled aria-label="{{ 'zootify_media_stories.previous' | t | escape }}" aria-controls="ZootifyMediaTrack-{{ section.id }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button>
        <button class="zms__nav-button" data-zms-next type="button" aria-label="{{ 'zootify_media_stories.next' | t | escape }}" aria-controls="ZootifyMediaTrack-{{ section.id }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button>
      </div>
    </div>
    <ul class="zms__track" id="ZootifyMediaTrack-{{ section.id }}" data-zms-track tabindex="0" aria-label="{{ s.heading | strip_html | default: shop.name | escape }}">
      {{ story_cards }}
    </ul>
    {% if s.show_progress %}<div class="zms__progress" data-zms-progress aria-hidden="true"><span></span></div>{% endif %}
  </zootify-media-stories>
{% endif %}

{% stylesheet %}
.zms {
  --zms-edge: var(--zms-edge-d);
  --zms-gutter: max(var(--zms-edge), calc((100% - var(--zms-max-width)) / 2));
  --zms-per-view: var(--zms-per-view-d);
  --zms-gap: var(--zms-gap-d);
  --zms-ratio: var(--zms-ratio-d);
  --zms-radius: var(--zms-radius-d);
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  padding-block: var(--zms-top-d) var(--zms-bottom-d);
  background: var(--zms-background);
  color: var(--zms-text);
  font-family: var(--font-body--family, inherit);
}
.zms *, .zms *::before, .zms *::after { box-sizing: border-box; }
.zms [hidden] { display: none !important; }
.zms__header {
  display: flex;
  gap: 24px;
  align-items: center;
  margin: 0 var(--zms-gutter) 32px;
}
.zms__intro { flex: 1; min-width: 0; text-align: var(--zms-align); }
.zms .zms__heading {
  margin: 0;
  max-width: none;
  font-family: var(--font-heading--family, var(--font-body--family, inherit));
  font-size: var(--zms-heading-d);
  font-weight: var(--zms-heading-weight);
  font-style: normal;
  line-height: 1.14;
  letter-spacing: -0.035em;
  text-transform: none;
  color: var(--zms-text);
  text-wrap: balance;
}
.zms .zms__subheading { margin: 10px 0 0; font: inherit; font-size: 16px; line-height: 1.5; color: var(--zms-muted); }
.zms__navigation { display: none; flex: 0 0 auto; gap: 12px; align-items: center; }
.zms.is-ready.has-overflow.zms--arrows .zms__navigation { display: flex; }
.zms .zms__nav-button {
  appearance: none;
  width: 44px;
  height: 44px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid color-mix(in srgb, var(--zms-text) 12%, transparent);
  border-radius: 50%;
  background: color-mix(in srgb, var(--zms-text) 4%, var(--zms-background));
  color: var(--zms-text);
  box-shadow: none;
  cursor: pointer;
  transition: background 160ms ease, border-color 160ms ease;
}
.zms .zms__nav-button:disabled { opacity: 0.3; cursor: default; }
.zms__nav-button svg { display: block; width: 20px; height: 20px; }
.zms__track {
  display: flex;
  align-items: stretch;
  gap: var(--zms-gap);
  list-style: none;
  width: 100%;
  margin: 0;
  padding: 0 var(--zms-gutter) 2px;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-padding-inline: var(--zms-gutter);
  scrollbar-width: none;
  overscroll-behavior-inline: contain;
  -webkit-overflow-scrolling: touch;
}
.zms__track::-webkit-scrollbar { display: none; }
.zms__card {
  position: relative;
  isolation: isolate;
  flex: 0 0 calc((100% - (var(--zms-per-view) - 1) * var(--zms-gap)) / var(--zms-per-view));
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: var(--zms-radius);
  aspect-ratio: var(--zms-ratio);
  background: var(--zms-card-background);
  scroll-snap-align: start;
}
.zms__media, .zms__media picture, .zms__native { position: absolute; inset: 0; display: block; }
.zms__media picture { transition: opacity 180ms ease; }
.zms .zms__image, .zms .zms__video, .zms__native video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: var(--zms-fit);
  object-position: var(--zms-position);
  border-radius: 0;
}
.zms .zms__video { position: absolute; inset: 0; opacity: 0; }
.zms__card.has-started .zms__video { opacity: 1; }
.zms__card.has-started [data-zms-poster] { opacity: 0; }
.zms__card.has-error .zms__video { opacity: 0; }
.zms__card.has-error [data-zms-poster] { opacity: 1; }
.zms__native { z-index: 3; }
.zms__placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 28px; text-align: center; color: var(--zms-muted); font-size: 14px; }
.zms__placeholder-svg { width: 75%; max-height: 65%; fill: currentColor; opacity: 0.32; }
.zms .zms__icon-button {
  appearance: none;
  position: absolute;
  z-index: 4;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  width: 48px;
  height: 48px;
  flex: 0 0 auto;
  border: 1px solid rgb(255 255 255 / 16%);
  border-radius: 50%;
  background: var(--zms-control-background);
  color: var(--zms-control-color);
  text-decoration: none;
  box-shadow: none;
  cursor: pointer;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  touch-action: manipulation;
  transition: background 160ms ease, border-color 160ms ease;
}
.zms__icon-button svg { width: 22px; height: 22px; display: block; }
.zms .zms__play { top: 50%; left: 50%; transform: translate(-50%, -50%); width: 56px; height: 56px; }
.zms .zms__play svg { width: 26px; height: 26px; }
.zms .zms__mute { top: 20px; right: 20px; }
.zms .zms__product-link { position: relative; align-self: flex-end; }
.zms:not(.is-ready) .zms__play, .zms:not(.is-ready) .zms__mute { display: none; }
.zms__icon-pause, .zms__icon-unmuted { display: none !important; }
.zms__card.is-playing .zms__icon-play, .zms__card:not(.is-muted) .zms__icon-muted { display: none !important; }
.zms__card.is-playing .zms__icon-pause, .zms__card:not(.is-muted) .zms__icon-unmuted { display: block !important; }
.zms .zms__card.is-playing .zms__play { top: 20px; left: 20px; transform: none; width: 48px; height: 48px; }
.zms .zms__card.is-playing .zms__play svg { width: 20px; height: 20px; }
.zms__card.is-loading:not(.is-playing) .zms__play .zms__icon-play { opacity: 0; }
.zms__card.is-loading:not(.is-playing) .zms__play::after {
  content: '';
  position: absolute;
  width: 22px;
  height: 22px;
  border: 2px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: zms-loading 800ms linear infinite;
}
@keyframes zms-loading { to { transform: rotate(360deg); } }
.zms__caption {
  position: absolute;
  z-index: 2;
  inset: auto 0 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  padding: 80px 24px 28px;
  color: var(--zms-card-text);
  pointer-events: none;
}
.zms__caption::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 35%) 48%, #000 100%); opacity: var(--zms-overlay); }
.zms__copy { min-width: 0; }
.zms__caption a { pointer-events: auto; }
.zms .zms__card-title { margin: 0; font-family: inherit; font-size: var(--zms-title-d); font-weight: 600; line-height: 1.3; letter-spacing: -0.02em; text-transform: none; color: var(--zms-card-text); overflow-wrap: anywhere; }
.zms .zms__card-caption { margin: 5px 0 0; font-family: inherit; font-size: var(--zms-caption-d); font-weight: 400; line-height: 1.4; color: var(--zms-card-muted); }
.zms__card-title, .zms__card-caption { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.zms .zms__error { position: absolute; z-index: 5; top: 50%; left: 16px; right: 16px; transform: translateY(40px); padding: 10px 12px; border-radius: 6px; background: rgb(0 0 0 / 80%); color: #fff; font-size: 12px; line-height: 1.4; text-align: center; }
.zms__progress { display: none; width: 88px; height: 3px; margin: 24px auto 0; overflow: hidden; border-radius: 3px; background: color-mix(in srgb, var(--zms-text) 12%, transparent); }
.zms.is-ready.has-overflow .zms__progress { display: block; }
.zms__progress span { display: block; width: 24px; height: 3px; background: var(--zms-text); border-radius: inherit; transform: translateX(calc(var(--progress, 0) * 64px)); transition: transform 120ms linear; }
.zms button:focus-visible, .zms a:focus-visible { outline: 3px solid var(--zms-accent); outline-offset: -3px; }
.zms__track:focus-visible { outline: 2px solid var(--zms-accent); outline-offset: -2px; }
@media (hover: hover) {
  .zms .zms__nav-button:not(:disabled):hover { background: var(--zms-accent); border-color: var(--zms-accent); }
  .zms .zms__icon-button:hover { background: color-mix(in srgb, var(--zms-accent) 85%, #000); border-color: transparent; color: #01161e; }
}
@media screen and (max-width: 899px) {
  .zms { --zms-per-view: 2.1; --zms-gap: var(--zms-gap-m); }
}
@media screen and (max-width: 749px) {
  .zms { --zms-edge: var(--zms-edge-m); --zms-ratio: var(--zms-ratio-m); --zms-radius: var(--zms-radius-m); padding-block: var(--zms-top-m) var(--zms-bottom-m); }
  .zms__header { flex-wrap: wrap; gap: 16px; margin-bottom: 20px; }
  .zms__intro { flex-basis: 100%; }
  .zms .zms__heading { font-size: var(--zms-heading-m); line-height: 1.16; letter-spacing: -0.025em; text-wrap: initial; }
  .zms .zms__subheading { font-size: 14px; margin-top: 8px; }
  .zms.is-ready.has-overflow.zms--arrows:not(.zms--mobile-arrows) .zms__navigation { display: none; }
  .zms.is-ready.has-overflow.zms--mobile-arrows .zms__navigation { display: flex; margin-left: auto; }
  .zms .zms__icon-button { width: 44px; height: 44px; }
  .zms .zms__play { width: 48px; height: 48px; }
  .zms .zms__mute { top: 12px; right: 12px; }
  .zms .zms__card.is-playing .zms__play { top: 12px; left: 12px; width: 44px; height: 44px; }
  .zms__caption { gap: 10px; padding: 64px 16px 20px; }
  .zms .zms__card-title { font-size: var(--zms-title-m); }
  .zms .zms__card-caption { font-size: var(--zms-caption-m); margin-top: 4px; }
  .zms__progress { margin-top: 20px; }
}
@media screen and (max-width: 499px) { .zms { --zms-per-view: var(--zms-per-view-m); } }
@media (prefers-reduced-motion: reduce) { .zms *, .zms *::before, .zms *::after { transition: none !important; scroll-behavior: auto !important; animation: none !important; } }

{% endstylesheet %}

{% javascript %}
if (!customElements.get('zootify-media-stories')) {
  class ZootifyMediaStories extends HTMLElement {
    connectedCallback() {
      this.startupFrame = requestAnimationFrame(() => this.initialize());
    }

    initialize() {
      if (!this.isConnected || this.abortController) return;
      this.track = this.querySelector('[data-zms-track]');
      if (!this.track) return;
      this.abortController = new AbortController();
      const signal = this.abortController.signal;
      this.generation = (this.generation || 0) + 1;
      this.isDesktop = window.matchMedia('(min-width: 769px)');
      this.cards = Array.from(this.track.querySelectorAll('[data-zms-card]'));
      this.previousButton = this.querySelector('[data-zms-prev]');
      this.nextButton = this.querySelector('[data-zms-next]');
      this.progress = this.querySelector('[data-zms-progress]');
      this.dots = Array.from(this.querySelectorAll('[data-zms-dot]'));
      this.reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      this.rtl = getComputedStyle(this.track).direction === 'rtl';
      this.active = null;
      this.peerOwner = null;
      this.states = this.cards.map(card => ({
        card,
        template: card.querySelector('template[data-zms-video-template]'),
        mount: card.querySelector('.zms__media'),
        playButton: card.querySelector('[data-zms-play]'),
        muteButton: card.querySelector('[data-zms-mute]'),
        error: card.querySelector('[data-zms-error]'),
        video: null,
        phase: 'idle',
        ratio: 0,
        horizontalVisibility: 0,
        verticalVisibility: 0,
        eligible: false,
        wasEligible: false,
        token: 0,
        generation: this.generation,
        shouldPlay: false,
        requested: false,
        userPaused: false,
        autoBlocked: false,
        retryExhausted: false,
        retryCount: 0,
        retryTimer: null,
        mediaFailed: false,
        manual: false
      }));

      for (const state of this.states) {
        if (!state.template) continue;
        state.card.classList.add('is-muted');
