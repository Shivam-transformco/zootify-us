    measureCards() {
      const viewport = this.viewportBounds();
      const track = this.track.getBoundingClientRect();
      this.nearViewport = track.width > 0 && track.height > 0 &&
        track.bottom > viewport.top - 300 && track.top < viewport.bottom + 300;
      for (const state of this.states) {
        const rect = state.card.getBoundingClientRect();
        const width = Math.max(0, Math.min(rect.right, track.right, viewport.right) - Math.max(rect.left, track.left, viewport.left));
        const height = Math.max(0, Math.min(rect.bottom, track.bottom, viewport.bottom) - Math.max(rect.top, track.top, viewport.top));
        state.horizontalVisibility = rect.width > 0 ? width / rect.width : 0;
        state.verticalVisibility = rect.height > 0 ? height / Math.min(rect.height, viewport.height) : 0;
