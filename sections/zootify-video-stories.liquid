    maxScroll() {
      return Math.max(0, this.track.scrollWidth - this.track.clientWidth);
    }

    position() {
      return Math.max(0, this.track.scrollLeft * (this.rtl ? -1 : 1));
    }

    scrollToPosition(value, behavior) {
      const left = Math.min(this.maxScroll(), Math.max(0, value));
      this.track.scrollTo({
        left: left * (this.rtl ? -1 : 1),
        behavior: behavior || (this.reducedMotion.matches ? 'auto' : 'smooth')
