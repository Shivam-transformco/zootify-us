<script>
  (() => {
    const sectionId = 'AnimatedAbout-{{ section.id }}';

    const initAnimatedAbout = () => {
      const root = document.getElementById(sectionId);
      if (!root || root.dataset.zaReady === 'true') return;

      root.dataset.zaReady = 'true';
      const items = root.querySelectorAll('[data-za-reveal]');
      const enabled = root.dataset.animationEnabled === 'true';
      const replay = root.dataset.animationReplay === 'true';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!enabled || reducedMotion || !('IntersectionObserver' in window)) {
        items.forEach((item) => item.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            if (!replay) observer.unobserve(entry.target);
          } else if (replay) {
            entry.target.classList.remove('is-visible');
          }
        });
      }, {
        threshold: 0.16,
        rootMargin: '0px 0px -8% 0px'
      });

      items.forEach((item) => observer.observe(item));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAnimatedAbout, { once: true });
    } else {
      initAnimatedAbout();
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') {
        const root = document.getElementById(sectionId);
        if (root) delete root.dataset.zaReady;
        initAnimatedAbout();
      }
    });

    document.addEventListener('shopify:block:select', (event) => {
      if (event.detail.sectionId !== '{{ section.id }}') return;
      const block = document.querySelector(`#${sectionId} [data-shopify-editor-block*="${event.detail.blockId}"]`);
      if (block) {
        block.querySelectorAll('[data-za-reveal]').forEach((item) => item.classList.add('is-visible'));
        block.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  })();
</script>

