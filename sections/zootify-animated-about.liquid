{% liquid
  assign hero_has_mobile = false
  if section.settings.hero_mobile_video != blank or section.settings.hero_mobile_image != blank
    assign hero_has_mobile = true
  endif
%}

<section
  id="AnimatedAbout-{{ section.id }}"
  class="za-about"
  data-za-about
  data-animation-enabled="{{ section.settings.enable_animation }}"
  data-animation-replay="{{ section.settings.replay_animation }}"
  style="
    --za-page-bg: {{ section.settings.page_background }};
    --za-content-width: {{ section.settings.content_width }}px;
    --za-side-pad-desktop: {{ section.settings.side_padding_desktop }}px;
    --za-side-pad-mobile: {{ section.settings.side_padding_mobile }}px;
    --za-gap-desktop: {{ section.settings.column_gap_desktop }}px;
    --za-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --za-eyebrow-size-desktop: {{ section.settings.eyebrow_size_desktop }}px;
    --za-eyebrow-size-mobile: {{ section.settings.eyebrow_size_mobile }}px;
    --za-eyebrow-weight: {{ section.settings.eyebrow_weight }};
    --za-eyebrow-line: {{ section.settings.eyebrow_line_height }};
    --za-eyebrow-space: {{ section.settings.eyebrow_letter_spacing }}px;
    --za-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --za-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --za-heading-weight: {{ section.settings.heading_weight }};
    --za-heading-line: {{ section.settings.heading_line_height }};
    --za-heading-space: {{ section.settings.heading_letter_spacing }}px;
    --za-body-size-desktop: {{ section.settings.body_size_desktop }}px;
    --za-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --za-body-weight: {{ section.settings.body_weight }};
    --za-body-line: {{ section.settings.body_line_height }};
    --za-body-space: {{ section.settings.body_letter_spacing }}px;
    --za-button-size-desktop: {{ section.settings.button_size_desktop }}px;
    --za-button-size-mobile: {{ section.settings.button_size_mobile }}px;
    --za-button-weight: {{ section.settings.button_weight }};
    --za-button-radius: {{ section.settings.button_radius }}px;
    --za-button-border-width: {{ section.settings.button_border_width }}px;
    --za-button-pad-x-desktop: {{ section.settings.button_padding_x_desktop }}px;
    --za-button-pad-y-desktop: {{ section.settings.button_padding_y_desktop }}px;
    --za-button-pad-x-mobile: {{ section.settings.button_padding_x_mobile }}px;
    --za-button-pad-y-mobile: {{ section.settings.button_padding_y_mobile }}px;
    --za-animation-duration: {{ section.settings.animation_duration }}ms;
    --za-animation-distance: {{ section.settings.animation_distance }}px;
    --za-animation-ease: {{ section.settings.animation_easing }};
  "
>
  {% if section.settings.show_hero %}
    <div
      class="za-about__hero{% if hero_has_mobile %} za-about__hero--has-mobile{% endif %}"
      style="
        --za-hero-height-desktop: {{ section.settings.hero_height_desktop }}px;
        --za-hero-height-mobile: {{ section.settings.hero_height_mobile }}px;
        --za-hero-overlay: {{ section.settings.hero_overlay_color }};
        --za-hero-overlay-opacity: {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }};
        --za-hero-content-width: {{ section.settings.hero_content_width }}px;
        --za-hero-pad-desktop: {{ section.settings.hero_padding_desktop }}px;
        --za-hero-pad-mobile: {{ section.settings.hero_padding_mobile }}px;
        --za-hero-heading-desktop: {{ section.settings.hero_heading_size_desktop }}px;
        --za-hero-heading-mobile: {{ section.settings.hero_heading_size_mobile }}px;
        --za-hero-heading-weight: {{ section.settings.hero_heading_weight }};
        --za-hero-heading-line: {{ section.settings.hero_heading_line_height }};
        --za-hero-heading-space: {{ section.settings.hero_heading_letter_spacing }}px;
        --za-hero-eyebrow-color: {{ section.settings.hero_eyebrow_color }};
        --za-hero-heading-color: {{ section.settings.hero_heading_color }};
        --za-hero-position-desktop: {{ section.settings.hero_position_desktop }};
        --za-hero-position-mobile: {{ section.settings.hero_position_mobile }};
      "
    >
      <div class="za-about__hero-media za-about__hero-media--desktop" aria-hidden="true">
        {% if section.settings.hero_video != blank %}
          {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'za-about__hero-video' }}
        {% elsif section.settings.hero_image != blank %}
          <img
            class="za-about__hero-image"
            src="{{ section.settings.hero_image | image_url: width: 2400 }}"
            srcset="
              {{ section.settings.hero_image | image_url: width: 750 }} 750w,
              {{ section.settings.hero_image | image_url: width: 1100 }} 1100w,
              {{ section.settings.hero_image | image_url: width: 1500 }} 1500w,
              {{ section.settings.hero_image | image_url: width: 2000 }} 2000w,
              {{ section.settings.hero_image | image_url: width: 2400 }} 2400w
            "
            sizes="100vw"
            alt="{{ section.settings.hero_image.alt | default: section.settings.hero_heading | escape }}"
            width="{{ section.settings.hero_image.width }}"
            height="{{ section.settings.hero_image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'za-about__placeholder' }}
        {% endif %}
      </div>

      {% if hero_has_mobile %}
        <div class="za-about__hero-media za-about__hero-media--mobile" aria-hidden="true">
          {% if section.settings.hero_mobile_video != blank %}
            {{ section.settings.hero_mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'za-about__hero-video' }}
          {% elsif section.settings.hero_mobile_image != blank %}
            <img
              class="za-about__hero-image"
              src="{{ section.settings.hero_mobile_image | image_url: width: 1200 }}"
              srcset="
                {{ section.settings.hero_mobile_image | image_url: width: 480 }} 480w,
                {{ section.settings.hero_mobile_image | image_url: width: 750 }} 750w,
                {{ section.settings.hero_mobile_image | image_url: width: 960 }} 960w,
                {{ section.settings.hero_mobile_image | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
              alt="{{ section.settings.hero_mobile_image.alt | default: section.settings.hero_heading | escape }}"
              width="{{ section.settings.hero_mobile_image.width }}"
              height="{{ section.settings.hero_mobile_image.height }}"
              loading="eager"
              fetchpriority="high"
            >
          {% endif %}
        </div>
      {% endif %}

      <div class="za-about__hero-overlay" aria-hidden="true"></div>

      <div class="za-about__hero-position za-about__hero-position--desktop za-about__hero-position--{{ section.settings.hero_horizontal_desktop }} za-about__hero-position--v-{{ section.settings.hero_vertical_desktop }}">
        <div
          class="za-about__hero-content za-about__text-{{ section.settings.hero_text_align_desktop }}"
          data-za-reveal
          data-animation="{{ section.settings.hero_animation }}"
          style="--za-delay: {{ section.settings.hero_animation_delay }}ms;"
        >
          {% if section.settings.hero_eyebrow != blank %}
            <div class="za-about__hero-eyebrow">{{ section.settings.hero_eyebrow | escape }}</div>
          {% endif %}
          {% if section.settings.hero_heading != blank %}
            <{{ section.settings.hero_heading_tag }} class="za-about__hero-heading">{{ section.settings.hero_heading | escape }}</{{ section.settings.hero_heading_tag }}>
          {% endif %}
        </div>
      </div>

      <div class="za-about__hero-position za-about__hero-position--mobile za-about__hero-position--{{ section.settings.hero_horizontal_mobile }} za-about__hero-position--v-{{ section.settings.hero_vertical_mobile }}">
        <div
          class="za-about__hero-content za-about__text-{{ section.settings.hero_text_align_mobile }}"
          data-za-reveal
          data-animation="{{ section.settings.hero_animation }}"
          style="--za-delay: {{ section.settings.hero_animation_delay }}ms;"
        >
          {% if section.settings.hero_eyebrow != blank %}
            <div class="za-about__hero-eyebrow">{{ section.settings.hero_eyebrow | escape }}</div>
          {% endif %}
          {% if section.settings.hero_heading != blank %}
            <{{ section.settings.hero_heading_tag }} class="za-about__hero-heading">{{ section.settings.hero_heading | escape }}</{{ section.settings.hero_heading_tag }}>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="za-about__blocks">
    {% for block in section.blocks %}
      {% liquid
        assign block_has_mobile = false
        if block.settings.mobile_video != blank or block.settings.mobile_image != blank
          assign block_has_mobile = true
        endif

        assign block_heading_desktop = section.settings.heading_size_desktop | times: block.settings.heading_scale | divided_by: 100
        assign block_heading_mobile = section.settings.heading_size_mobile | times: block.settings.heading_scale | divided_by: 100
      %}

      <article
        class="za-about__block za-about__block--{{ block.settings.layout }}{% if section.settings.show_dividers %} za-about__block--divider{% endif %}"
        style="
          --za-block-bg: {{ block.settings.background_color }};
          --za-block-text: {{ block.settings.text_color }};
          --za-block-heading: {{ block.settings.heading_color }};
          --za-block-eyebrow: {{ block.settings.eyebrow_color }};
          --za-block-pad-top-desktop: {{ block.settings.padding_top_desktop }}px;
          --za-block-pad-bottom-desktop: {{ block.settings.padding_bottom_desktop }}px;
          --za-block-pad-top-mobile: {{ block.settings.padding_top_mobile }}px;
          --za-block-pad-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;
          --za-block-min-height: {{ block.settings.min_height_desktop }}px;
          --za-block-media-width: {{ block.settings.media_width }}%;
          --za-block-media-height-desktop: {{ block.settings.media_height_desktop }}px;
          --za-block-media-height-mobile: {{ block.settings.media_height_mobile }}px;
          --za-block-content-width: {{ block.settings.text_max_width }}px;
          --za-block-heading-desktop: {{ block_heading_desktop }}px;
          --za-block-heading-mobile: {{ block_heading_mobile }}px;
          --za-block-position-desktop: {{ block.settings.image_position_desktop }};
          --za-block-position-mobile: {{ block.settings.image_position_mobile }};
          --za-divider-color: {{ section.settings.divider_color }};
        "
        {{ block.shopify_attributes }}
      >
        <div
          class="za-about__block-inner za-about__layout-{{ block.settings.layout }} za-about__vertical-{{ block.settings.vertical_alignment }} za-about__mobile-order-{{ block.settings.mobile_order }}"
        >
          {% unless block.settings.layout == 'text_only' %}
            <div
              class="za-about__media{% if block_has_mobile %} za-about__media--has-mobile{% endif %}{% if section.settings.enable_image_hover %} za-about__media--hover{% endif %}"
              data-za-reveal
              data-animation="{{ block.settings.media_animation }}"
              style="--za-delay: {{ block.settings.animation_delay }}ms;"
            >
              <div class="za-about__media-source za-about__media-source--desktop">
                {% if block.settings.video != blank %}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'za-about__video' }}
                {% elsif block.settings.image != blank %}
                  <img
                    class="za-about__image"
                    src="{{ block.settings.image | image_url: width: 1800 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 480 }} 480w,
                      {{ block.settings.image | image_url: width: 750 }} 750w,
                      {{ block.settings.image | image_url: width: 1100 }} 1100w,
                      {{ block.settings.image | image_url: width: 1500 }} 1500w,
                      {{ block.settings.image | image_url: width: 1800 }} 1800w
                    "
                    sizes="(min-width: 990px) {{ block.settings.media_width }}vw, 100vw"
                    alt="{{ block.settings.image_alt | default: block.settings.image.alt | default: block.settings.heading | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'za-about__placeholder' }}
                {% endif %}
              </div>

              {% if block_has_mobile %}
                <div class="za-about__media-source za-about__media-source--mobile">
                  {% if block.settings.mobile_video != blank %}
                    {{ block.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'za-about__video' }}
                  {% elsif block.settings.mobile_image != blank %}
                    <img
                      class="za-about__image"
                      src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
                      srcset="
                        {{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                        {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                        {{ block.settings.mobile_image | image_url: width: 960 }} 960w,
                        {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w
                      "
                      sizes="100vw"
                      alt="{{ block.settings.image_alt | default: block.settings.mobile_image.alt | default: block.settings.heading | escape }}"
                      width="{{ block.settings.mobile_image.width }}"
                      height="{{ block.settings.mobile_image.height }}"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endunless %}

          {% unless block.settings.layout == 'media_only' %}
            <div
              class="za-about__content za-about__text-{{ block.settings.text_align_desktop }} za-about__text-mobile-{{ block.settings.text_align_mobile }}"
              data-za-reveal
              data-animation="{{ block.settings.text_animation }}"
              style="--za-delay: {{ block.settings.animation_delay | plus: 100 }}ms;"
            >
              {% if block.settings.eyebrow != blank %}
                <div class="za-about__eyebrow">{{ block.settings.eyebrow | escape }}</div>
              {% endif %}

              {% if block.settings.heading != blank %}
                <{{ block.settings.heading_tag }} class="za-about__heading">{{ block.settings.heading | escape }}</{{ block.settings.heading_tag }}>
              {% endif %}

              {% if block.settings.body != blank %}
                <div class="za-about__body rte">{{ block.settings.body }}</div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a
                  class="za-about__button"
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  style="
                    --za-button-bg: {{ block.settings.button_background }};
                    --za-button-text: {{ block.settings.button_text_color }};
                    --za-button-border: {{ block.settings.button_border_color }};
                    --za-button-hover-bg: {{ block.settings.button_hover_background }};
                    --za-button-hover-text: {{ block.settings.button_hover_text_color }};
                  "
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {% endif %}
            </div>
          {% endunless %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<style>
  #AnimatedAbout-{{ section.id }} {
    background: var(--za-page-bg);
    width: 100%;
    overflow: hidden;
  }

  #AnimatedAbout-{{ section.id }} * {
    box-sizing: border-box;
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero {
    position: relative;
    width: 100%;
    min-height: var(--za-hero-height-desktop);
    overflow: hidden;
    isolation: isolate;
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-media,
  #AnimatedAbout-{{ section.id }} .za-about__hero-overlay,
  #AnimatedAbout-{{ section.id }} .za-about__hero-position {
    position: absolute;
    inset: 0;
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-media--mobile,
  #AnimatedAbout-{{ section.id }} .za-about__hero-position--mobile {
    display: none;
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-image,
  #AnimatedAbout-{{ section.id }} .za-about__hero-video,
  #AnimatedAbout-{{ section.id }} .za-about__hero-media .za-about__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: var(--za-hero-position-desktop);
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-overlay {
    z-index: 1;
    background: var(--za-hero-overlay);
    opacity: var(--za-hero-overlay-opacity);
    pointer-events: none;
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-position {
    z-index: 2;
    display: flex;
    padding: var(--za-hero-pad-desktop);
    pointer-events: none;
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-position--left { justify-content: flex-start; }
  #AnimatedAbout-{{ section.id }} .za-about__hero-position--center { justify-content: center; }
  #AnimatedAbout-{{ section.id }} .za-about__hero-position--right { justify-content: flex-end; }
  #AnimatedAbout-{{ section.id }} .za-about__hero-position--v-top { align-items: flex-start; }
  #AnimatedAbout-{{ section.id }} .za-about__hero-position--v-middle { align-items: center; }
  #AnimatedAbout-{{ section.id }} .za-about__hero-position--v-bottom { align-items: flex-end; }

  #AnimatedAbout-{{ section.id }} .za-about__hero-content {
    width: min(100%, var(--za-hero-content-width));
    pointer-events: auto;
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-eyebrow,
  #AnimatedAbout-{{ section.id }} .za-about__eyebrow {
    margin: 0 0 22px;
    font-size: var(--za-eyebrow-size-desktop);
    font-weight: var(--za-eyebrow-weight);
    line-height: var(--za-eyebrow-line);
    letter-spacing: var(--za-eyebrow-space);
    text-transform: uppercase;
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-eyebrow {
    color: var(--za-hero-eyebrow-color);
  }

  #AnimatedAbout-{{ section.id }} .za-about__hero-heading {
    margin: 0;
    color: var(--za-hero-heading-color);
    font-size: var(--za-hero-heading-desktop);
    font-weight: var(--za-hero-heading-weight);
    line-height: var(--za-hero-heading-line);
    letter-spacing: var(--za-hero-heading-space);
    text-transform: uppercase;
  }

  #AnimatedAbout-{{ section.id }} .za-about__block {
    width: 100%;
    background: var(--za-block-bg);
    color: var(--za-block-text);
    padding: var(--za-block-pad-top-desktop) var(--za-side-pad-desktop) var(--za-block-pad-bottom-desktop);
  }

  #AnimatedAbout-{{ section.id }} .za-about__block--divider {
    border-top: 1px solid var(--za-divider-color);
  }

  #AnimatedAbout-{{ section.id }} .za-about__block-inner {
    width: min(100%, var(--za-content-width));
    min-height: var(--za-block-min-height);
    margin: 0 auto;
    display: flex;
    gap: var(--za-gap-desktop);
  }

  #AnimatedAbout-{{ section.id }} .za-about__layout-media_left { flex-direction: row; }
  #AnimatedAbout-{{ section.id }} .za-about__layout-media_right { flex-direction: row-reverse; }
  #AnimatedAbout-{{ section.id }} .za-about__layout-media_top { flex-direction: column; }
  #AnimatedAbout-{{ section.id }} .za-about__layout-text_only {
    flex-direction: column;
  }

  #AnimatedAbout-{{ section.id }} .za-about__layout-media_only { display: block; }

  #AnimatedAbout-{{ section.id }} .za-about__layout-text_only.za-about__vertical-top { justify-content: flex-start; }
  #AnimatedAbout-{{ section.id }} .za-about__layout-text_only.za-about__vertical-center { justify-content: center; }
  #AnimatedAbout-{{ section.id }} .za-about__layout-text_only.za-about__vertical-bottom { justify-content: flex-end; }

  #AnimatedAbout-{{ section.id }} .za-about__vertical-top { align-items: flex-start; }
  #AnimatedAbout-{{ section.id }} .za-about__vertical-center { align-items: center; }
  #AnimatedAbout-{{ section.id }} .za-about__vertical-bottom { align-items: flex-end; }

  #AnimatedAbout-{{ section.id }} .za-about__media {
    position: relative;
    flex: 0 1 var(--za-block-media-width);
    height: var(--za-block-media-height-desktop);
    overflow: hidden;
    background: #f2f2f2;
  }

  #AnimatedAbout-{{ section.id }} .za-about__layout-media_top .za-about__media,
  #AnimatedAbout-{{ section.id }} .za-about__layout-media_only .za-about__media {
    width: 100%;
    max-width: 100%;
  }

  #AnimatedAbout-{{ section.id }} .za-about__media-source {
    position: absolute;
    inset: 0;
  }

  #AnimatedAbout-{{ section.id }} .za-about__media-source--mobile {
    display: none;
  }

  #AnimatedAbout-{{ section.id }} .za-about__image,
  #AnimatedAbout-{{ section.id }} .za-about__video,
  #AnimatedAbout-{{ section.id }} .za-about__media .za-about__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: var(--za-block-position-desktop);
    transition: transform 700ms ease;
  }

  #AnimatedAbout-{{ section.id }} .za-about__media--hover:hover .za-about__image,
  #AnimatedAbout-{{ section.id }} .za-about__media--hover:hover .za-about__video {
    transform: scale(1.035);
  }

  #AnimatedAbout-{{ section.id }} .za-about__content {
    flex: 1 1 0;
    width: min(100%, var(--za-block-content-width));
    max-width: var(--za-block-content-width);
  }

  #AnimatedAbout-{{ section.id }} .za-about__layout-media_top .za-about__content,
  #AnimatedAbout-{{ section.id }} .za-about__layout-text_only .za-about__content {
    margin-inline: auto;
  }

  #AnimatedAbout-{{ section.id }} .za-about__eyebrow {
    color: var(--za-block-eyebrow);
  }

  #AnimatedAbout-{{ section.id }} .za-about__heading {
    margin: 0 0 30px;
    color: var(--za-block-heading);
    font-size: var(--za-block-heading-desktop);
    font-weight: var(--za-heading-weight);
    line-height: var(--za-heading-line);
    letter-spacing: var(--za-heading-space);
    text-transform: uppercase;
  }

  #AnimatedAbout-{{ section.id }} .za-about__body {
    color: var(--za-block-text);
    font-size: var(--za-body-size-desktop);
    font-weight: var(--za-body-weight);
    line-height: var(--za-body-line);
    letter-spacing: var(--za-body-space);
  }

  #AnimatedAbout-{{ section.id }} .za-about__body > *:first-child { margin-top: 0; }
  #AnimatedAbout-{{ section.id }} .za-about__body > *:last-child { margin-bottom: 0; }
  #AnimatedAbout-{{ section.id }} .za-about__body p { margin: 0 0 1em; }
  #AnimatedAbout-{{ section.id }} .za-about__body a { color: inherit; text-underline-offset: 0.2em; }

  #AnimatedAbout-{{ section.id }} .za-about__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 30px;
    padding: var(--za-button-pad-y-desktop) var(--za-button-pad-x-desktop);
    border: var(--za-button-border-width) solid var(--za-button-border);
    border-radius: var(--za-button-radius);
    background: var(--za-button-bg);
    color: var(--za-button-text);
    font-size: var(--za-button-size-desktop);
    font-weight: var(--za-button-weight);
    line-height: 1;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  #AnimatedAbout-{{ section.id }} .za-about__button:hover {
    background: var(--za-button-hover-bg);
    color: var(--za-button-hover-text);
    transform: translateY(-1px);
  }

  #AnimatedAbout-{{ section.id }} .za-about__text-left { text-align: left; }
  #AnimatedAbout-{{ section.id }} .za-about__text-center { text-align: center; }
