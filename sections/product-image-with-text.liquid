{% comment %}
  Product Image with Text - SAFE EXTENSION VERSION

  IMPORTANT:
  - Keeps the original 3 product metafield sets untouched and renders them first.
  - Adds unlimited extra image/video feature items from:
      product.metafields.custom.feature_media_blocks
  - Existing product metafield data does NOT need to be migrated.
  - Do not delete, rename, or change the type of the existing metafield definitions.

  New repeatable metaobject expected fields:
  - media      (File: image or video)
  - heading    (Single line text)
  - subheading (Multi-line text or rich text)
{% endcomment %}

{%- assign sets = '1,2,3' | split: ',' -%}
{%- assign repeatable_items = product.metafields.custom.feature_media_blocks.value -%}
{%- assign has_any = false -%}

{%- comment -%} Check the original 3 metafield sets without changing them. {%- endcomment -%}
{%- for n in sets -%}
  {%- assign media_key = 'image_with_text_image_' | append: n -%}
  {%- assign head_key = 'image_with_text_heading_' | append: n -%}
  {%- assign desc_key = 'image_with_text_sub_heading_' | append: n -%}

  {%- assign legacy_media = product.metafields.custom[media_key].value -%}
  {%- assign legacy_heading = product.metafields.custom[head_key] | metafield_tag -%}
  {%- assign legacy_description = product.metafields.custom[desc_key] | metafield_tag -%}

  {%- assign legacy_heading_check = legacy_heading | strip_html | strip -%}
  {%- assign legacy_desc_check = legacy_description | strip_html | strip -%}

  {%- if legacy_media != blank or legacy_heading_check != blank or legacy_desc_check != blank -%}
    {%- assign has_any = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Also check the new repeatable extras. {%- endcomment -%}
{%- unless has_any -%}
  {%- if repeatable_items != blank -%}
    {%- for item in repeatable_items -%}
      {%- assign feature_media = item.media.value -%}
      {%- assign feature_heading = item.heading.value | default: '' | strip -%}
      {%- assign feature_desc_html = item.subheading | metafield_tag -%}
      {%- assign feature_desc_check = feature_desc_html | strip_html | strip -%}

      {%- if feature_media != blank or feature_heading != blank or feature_desc_check != blank -%}
        {%- assign has_any = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endunless -%}

{% if has_any %}

<div class="iwt-wrapper-{{ section.id }}">

  {%- assign render_index = 0 -%}

  {%- comment -%}
    FIRST: render the original 3 metafield sets.
    This preserves all existing product content exactly where it already lives.
  {%- endcomment -%}
  {%- for n in sets -%}
    {%- assign media_key = 'image_with_text_image_' | append: n -%}
    {%- assign head_key = 'image_with_text_heading_' | append: n -%}
    {%- assign desc_key = 'image_with_text_sub_heading_' | append: n -%}

    {%- assign meta_media = product.metafields.custom[media_key].value -%}
    {%- assign meta_heading = product.metafields.custom[head_key] | metafield_tag -%}
    {%- assign meta_description = product.metafields.custom[desc_key] | metafield_tag -%}

    {%- assign heading_check = meta_heading | strip_html | strip -%}
    {%- assign desc_check = meta_description | strip_html | strip -%}

    {% if meta_media != blank or heading_check != blank or desc_check != blank %}
      {%- assign render_index = render_index | plus: 1 -%}
      {%- assign mod = render_index | modulo: 2 -%}

      {%- if section.settings.alternate_layout -%}
        {%- if mod == 0 -%}
          {%- assign block_layout = 'image_right' -%}
        {%- else -%}
          {%- assign block_layout = 'image_left' -%}
        {%- endif -%}
      {%- else -%}
        {%- assign block_layout = section.settings.layout -%}
      {%- endif -%}

      <section class="iwt-{{ section.id }} iwt-block iwt-layout--{{ block_layout }}">
        <div class="iwt-wrap">

          {% if meta_media != blank %}
            <div class="iwt-media">
              {% case meta_media.media_type %}
                {% when 'video' %}
                  {{
                    meta_media
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata',
                      class: 'iwt-img'
                  }}
                {% else %}
                  <img
                    src="{{ meta_media | image_url: width: 1200 }}"
                    srcset="
                      {{ meta_media | image_url: width: 400 }} 400w,
                      {{ meta_media | image_url: width: 600 }} 600w,
                      {{ meta_media | image_url: width: 800 }} 800w,
                      {{ meta_media | image_url: width: 1200 }} 1200w,
                      {{ meta_media | image_url: width: 1600 }} 1600w
                    "
                    sizes="(max-width: 767px) 100vw, 50vw"
                    alt="{{ heading_check | default: product.title | escape }}"
                    width="{{ meta_media.width }}"
                    height="{{ meta_media.height }}"
                    loading="lazy"
                    decoding="async"
                    class="iwt-img"
                  >
              {% endcase %}
            </div>
          {% endif %}

          {% if heading_check != blank or desc_check != blank %}
            <div class="iwt-content">
              {% if heading_check != blank %}
                <h2 class="iwt-heading">{{ meta_heading }}</h2>
              {% endif %}

              {% if desc_check != blank %}
                <div class="iwt-desc">{{ meta_description }}</div>
              {% endif %}
            </div>
          {% endif %}

        </div>
      </section>
    {% endif %}
  {%- endfor -%}

  {%- comment -%}
    SECOND: append any number of NEW image/video feature items.
    These are additions only; they do not replace the original 3 metafields.
  {%- endcomment -%}
  {%- if repeatable_items != blank -%}
    {%- for item in repeatable_items -%}
      {%- assign feature_media = item.media.value -%}
      {%- assign feature_heading = item.heading.value | default: '' | strip -%}
      {%- assign feature_desc_html = item.subheading | metafield_tag -%}
      {%- assign feature_desc_check = feature_desc_html | strip_html | strip -%}

      {%- if feature_media != blank or feature_heading != blank or feature_desc_check != blank -%}
        {%- assign render_index = render_index | plus: 1 -%}
        {%- assign mod = render_index | modulo: 2 -%}

        {%- if section.settings.alternate_layout -%}
          {%- if mod == 0 -%}
            {%- assign block_layout = 'image_right' -%}
          {%- else -%}
            {%- assign block_layout = 'image_left' -%}
          {%- endif -%}
        {%- else -%}
          {%- assign block_layout = section.settings.layout -%}
        {%- endif -%}

        <section class="iwt-{{ section.id }} iwt-block iwt-layout--{{ block_layout }}">
          <div class="iwt-wrap">

            {% if feature_media != blank %}
              <div class="iwt-media">
                {% case feature_media.media_type %}
                  {% when 'video' %}
                    {{
                      feature_media
                      | video_tag:
                        autoplay: true,
                        loop: true,
                        muted: true,
                        controls: false,
                        playsinline: true,
                        preload: 'metadata',
                        class: 'iwt-img'
                    }}
                  {% when 'image' %}
                    <img
                      src="{{ feature_media | image_url: width: 1200 }}"
                      srcset="
                        {{ feature_media | image_url: width: 400 }} 400w,
                        {{ feature_media | image_url: width: 600 }} 600w,
                        {{ feature_media | image_url: width: 800 }} 800w,
                        {{ feature_media | image_url: width: 1200 }} 1200w,
                        {{ feature_media | image_url: width: 1600 }} 1600w
                      "
                      sizes="(max-width: 767px) 100vw, 50vw"
                      alt="{{ feature_heading | default: product.title | escape }}"
                      width="{{ feature_media.width }}"
                      height="{{ feature_media.height }}"
                      loading="lazy"
                      decoding="async"
                      class="iwt-img"
                    >
                  {% else %}
                    {% if feature_media.preview_image != blank %}
                      <img
                        src="{{ feature_media.preview_image | image_url: width: 1200 }}"
                        alt="{{ feature_heading | default: product.title | escape }}"
                        width="{{ feature_media.preview_image.width }}"
                        height="{{ feature_media.preview_image.height }}"
                        loading="lazy"
                        decoding="async"
                        class="iwt-img"
                      >
                    {% endif %}
                {% endcase %}
              </div>
            {% endif %}

            {% if feature_heading != blank or feature_desc_check != blank %}
              <div class="iwt-content">
                {% if feature_heading != blank %}
                  <h2 class="iwt-heading">{{ feature_heading | escape }}</h2>
                {% endif %}

                {% if feature_desc_check != blank %}
                  <div class="iwt-desc">{{ feature_desc_html }}</div>
                {% endif %}
              </div>
            {% endif %}

          </div>
        </section>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

</div>

<style>
  .iwt-wrapper-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .iwt-wrapper-{{ section.id }} .iwt-{{ section.id }} {
    width: 100%;
    padding-left: {{ section.settings.padding_x }}px;
    padding-right: {{ section.settings.padding_x }}px;
    box-sizing: border-box;
    margin-bottom: {{ section.settings.block_gap }}px;
  }

  .iwt-wrapper-{{ section.id }} .iwt-{{ section.id }}:last-child {
    margin-bottom: 0;
  }

  .iwt-wrapper-{{ section.id }} .iwt-wrap {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.gap }}px;
    align-items: center;
  }

  .iwt-wrapper-{{ section.id }} .iwt-layout--image_right .iwt-media { order: 2; }
  .iwt-wrapper-{{ section.id }} .iwt-layout--image_right .iwt-content { order: 1; }

  .iwt-wrapper-{{ section.id }} .iwt-media {
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
  }

  .iwt-wrapper-{{ section.id }} .iwt-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .iwt-wrapper-{{ section.id }} .iwt-content {
    color: {{ section.settings.text_color }};
  }

  .iwt-wrapper-{{ section.id }} .iwt-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    letter-spacing: -0.3px;
  }

  .iwt-wrapper-{{ section.id }} .iwt-heading p { margin: 0; }

  .iwt-wrapper-{{ section.id }} .iwt-desc {
    font-size: {{ section.settings.desc_size }}px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
  }

  .iwt-wrapper-{{ section.id }} .iwt-desc p { margin: 0 0 12px; }
  .iwt-wrapper-{{ section.id }} .iwt-desc p:last-child { margin-bottom: 0; }

  @media (max-width: 767px) {
    .iwt-wrapper-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .iwt-wrapper-{{ section.id }} .iwt-{{ section.id }} {
      padding-left: {{ section.settings.padding_x_mobile }}px;
      padding-right: {{ section.settings.padding_x_mobile }}px;
      margin-bottom: {{ section.settings.block_gap_mobile }}px;
    }

    .iwt-wrapper-{{ section.id }} .iwt-wrap {
      grid-template-columns: 1fr;
      gap: {{ section.settings.gap_mobile }}px;
    }

    .iwt-wrapper-{{ section.id }} .iwt-layout--image_right .iwt-media,
    .iwt-wrapper-{{ section.id }} .iwt-layout--image_left .iwt-media {
      order: {% if section.settings.mobile_image_first %}1{% else %}2{% endif %};
    }
    .iwt-wrapper-{{ section.id }} .iwt-layout--image_right .iwt-content,
    .iwt-wrapper-{{ section.id }} .iwt-layout--image_left .iwt-content {
      order: {% if section.settings.mobile_image_first %}2{% else %}1{% endif %};
    }

    .iwt-wrapper-{{ section.id }} .iwt-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .iwt-wrapper-{{ section.id }} .iwt-desc {
      font-size: {{ section.settings.desc_size_mobile }}px;
    }
  }
</style>

{% endif %}

{% schema %}
{
  "name": "Product Image with Text",
  "settings": [
    {
      "type": "paragraph",
      "content": "SAFE MODE: keeps the original 3 product metafield blocks and appends unlimited extra image/video feature items from feature_media_blocks. Existing product metafield data does not need migration."
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "alternate_layout",
      "label": "Alternate layout (image left, right, left...)",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Default layout (if alternate is OFF)",
      "options": [
        { "value": "image_left",  "label": "Image left, text right" },
        { "value": "image_right", "label": "Image right, text left" }
      ],
      "default": "image_left"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Image first on mobile",
      "default": true
    },

    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "desc_size",
      "label": "Description size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "label": "Description size (mobile)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "header",
      "content": "Spacing — Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Section top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Left/Right padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between image & text",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "block_gap",
      "label": "Gap between blocks",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },

    {
      "type": "header",
      "content": "Spacing — Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Section top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Section bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Left/Right padding (mobile)",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between image & text (mobile)",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "block_gap_mobile",
      "label": "Gap between blocks (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Product Image with Text",
      "category": "Product"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}