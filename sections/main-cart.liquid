      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "ZOOTIFY cart update"
    },
    {
      "type": "checkbox",
      "id": "zc_enable",
      "label": "Enable updated cart",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "All settings below apply only to this cart page. Shipping prices are display information, not checkout shipping settings."
    },
    {
      "type": "text",
      "id": "zc_heading",
      "label": "Order summary heading",
