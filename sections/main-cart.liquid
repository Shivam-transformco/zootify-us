      "label": "Discount control label",
      "default": "Apply discount code"
    },
    {
      "type": "text",
      "id": "zc_checkout_label",
      "label": "Checkout button label",
      "default": "Checkout"
    },
    {
      "type": "text",
      "id": "zc_wallet_label",
      "label": "Accelerated payments label",
      "default": "Or pay faster with"
