          "value": "auto",
          "label": "Automatic: row when there is room"
        },
        {
          "value": "vertical",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "zc_short_titles",
      "label": "Simplify supported product titles",
      "default": true,
      "info": "Shows the phone model separately. Known Frostand titles can also show the color. Product data and checkout titles are unchanged."
    },
    {
      "type": "header",
      "content": "Shipping information"
    },
    {
      "type": "checkbox",
      "id": "zc_free_shipping",
      "label": "Show free Standard shipping for US / USD carts",
      "default": true,
      "info": "Enable only while your actual US Standard shipping rate is free."
    },
    {
      "type": "checkbox",
      "id": "zc_show_express",
