{% comment %}
  Shop by Category - Pixel Perfect
{% endcomment %}

<section class="shop-category-{{ section.id }} section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="category-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="category-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>

          <div class="img-wrap">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.title | escape }}"
                class="category-image"
                loading="lazy"
                width=""
                height=""
              >
            {% endif %}
          </div>

          <div class="category-content">
            <span class="cat-title">{{ block.settings.title }}</span>

            <span class="arrow-line">
              <svg class="arrow-head" viewBox="0 0 60 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <line x1="0" y1="5" x2="55" y2="5" stroke="#000" stroke-width="1.2"/>
                <polyline points="50,1 56,5 50,9" fill="none" stroke="#000" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>

        </a>
      {% endfor %}
    </div>

  </div>
</section>

<style>

  .shop-category-{{ section.id }} .page-width {
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  /* HEADING */
  .shop-category-{{ section.id }} .category-heading {
    margin: 0 0 20px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    line-height: 1.1;
  }

  /* GRID */
  .shop-category-{{ section.id }} .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  /* CARD */
  .shop-category-{{ section.id }} .category-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #000;
    height: 100%;
    overflow: hidden;
  }

  /* IMAGE WRAP */
  .shop-category-{{ section.id }} .img-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    background: #f5f5f5;
  }

  /* IMAGE */
  .shop-category-{{ section.id }} .category-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* ONLY IMAGE ZOOM */
  .shop-category-{{ section.id }} .category-card:hover .category-image {
    transform: scale(1.06);
  }

  .shop-category-{{ section.id }} .category-card:hover {
    transform: none !important;
  }

  /* CONTENT */
  .shop-category-{{ section.id }} .category-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 4px 0;
    gap: 12px;
  }

  /* TITLE */
  .shop-category-{{ section.id }} .cat-title {
    font-size: 15px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ARROW */
  .shop-category-{{ section.id }} .arrow-line {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: flex-end;
  }

  .shop-category-{{ section.id }} .arrow-head {
    width: 60px;
    height: 10px;
    display: block;
  }

  /* MOBILE */
  @media (max-width: 767px) {

    .shop-category-{{ section.id }} .page-width {
      padding-left: {{ section.settings.padding_left_mobile }}px;
      padding-right: {{ section.settings.padding_right_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .shop-category-{{ section.id }} .category-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 12px;

      width: calc(100% + {{ section.settings.padding_left_mobile | plus: section.settings.padding_right_mobile }}px);

      margin-left: -{{ section.settings.padding_left_mobile }}px;
      margin-right: -{{ section.settings.padding_right_mobile }}px;

      padding-left: {{ section.settings.padding_left_mobile }}px;
      padding-right: {{ section.settings.padding_right_mobile }}px;

      box-sizing: border-box;
      scroll-padding-left: {{ section.settings.padding_left_mobile }}px;

      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .shop-category-{{ section.id }} .category-grid::-webkit-scrollbar {
      display: none;
    }

    .shop-category-{{ section.id }} .category-card {
      flex: 0 0 70%;
      min-width: 0;
      scroll-snap-align: start;
    }

    .shop-category-{{ section.id }} .img-wrap {
      border-radius: 12px;
    }

    .shop-category-{{ section.id }} .category-content {
      padding: 12px 2px 0;
    }

    .shop-category-{{ section.id }} .cat-title {
      font-size: 14px;
    }

    .shop-category-{{ section.id }} .arrow-head {
      width: 50px;
      height: 10px;
    }

    .shop-category-{{ section.id }} .category-heading {
      font-size: 18px;
      margin-bottom: 16px;
    }
  }

  @media (max-width: 480px) {
    .shop-category-{{ section.id }} .category-card {
      flex: 0 0 76%;
    }
  }

</style>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },

    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30
    },

    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Left padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Right padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],

  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Shop by Category"
    }
  ]
}
{% endschema %}