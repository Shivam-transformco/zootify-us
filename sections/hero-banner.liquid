{% comment %}
  Hero – Dynamic Slider. Existing media, appearance and editor controls preserved.
  Fix 2026-11-12: ignore descendant transition events; a single slide never translates.
{% endcomment %}
<section id="hero-{{ section.id }}" class="hero-dynamic" style="--mobile-hero-height: {{ section.settings.mobile_banner_height | default: 62 }}vh;">
  <div class="hero-slides" id="hero-track-{{ section.id }}">
    {% for block in section.blocks %}
      {% liquid
        if forloop.first and section.index == 1
          assign hero_img_priority = 'high'
        else
          assign hero_img_priority = 'auto'
        endif
      %}
      <div class="hero-slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="hero-desktop">
          {% if block.settings.desktop_layout == 'split' %}
            <div class="hero-media hero-split">
              <div class="hero-side">
                {% if block.settings.desktop_left_type == 'video' and block.settings.desktop_left_video != blank %}
                  <video autoplay loop muted playsinline data-hero-video data-video-src="{{ block.settings.desktop_left_video.sources[0].url }}"></video>
                {% elsif block.settings.desktop_left_image != blank %}
                  {{ block.settings.desktop_left_image | image_url: width: 1400 | image_tag: widths: '100, 480, 750, 1000, 1400', sizes: '(max-width: 768px) 1px, 50vw', loading: 'lazy', fetchpriority: hero_img_priority, alt: block.settings.desktop_left_image.alt }}
                {% endif %}
              </div>
              <div class="hero-side">
                {% if block.settings.desktop_right_type == 'video' and block.settings.desktop_right_video != blank %}
                  <video autoplay loop muted playsinline data-hero-video data-video-src="{{ block.settings.desktop_right_video.sources[0].url }}"></video>
                {% elsif block.settings.desktop_right_image != blank %}
                  {{ block.settings.desktop_right_image | image_url: width: 1400 | image_tag: widths: '100, 480, 750, 1000, 1400', sizes: '(max-width: 768px) 1px, 50vw', loading: 'lazy', fetchpriority: hero_img_priority, alt: block.settings.desktop_right_image.alt }}
                {% endif %}
              </div>
            </div>
          {% else %}
            <div class="hero-media hero-full">
              {% if block.settings.desktop_full_type == 'video' and block.settings.desktop_full_video != blank %}
                <video autoplay loop muted playsinline data-hero-video data-video-src="{{ block.settings.desktop_full_video.sources[0].url }}"></video>
              {% elsif block.settings.desktop_full_image != blank %}
                {{ block.settings.desktop_full_image | image_url: width: 1920 | image_tag: widths: '100, 750, 1100, 1500, 1920', sizes: '(max-width: 768px) 1px, 100vw', loading: 'lazy', fetchpriority: hero_img_priority, alt: block.settings.desktop_full_image.alt }}
              {% endif %}
            </div>
          {% endif %}
        </div>
        <div class="hero-mobile">
          {% if block.settings.mobile_layout == 'split' %}
            <div class="hero-media hero-split">
              <div class="hero-side">
                {% if block.settings.mobile_top_type == 'video' and block.settings.mobile_top_video != blank %}
                  <video autoplay loop muted playsinline data-hero-video data-video-src="{{ block.settings.mobile_top_video.sources[0].url }}"></video>
                {% elsif block.settings.mobile_top_image != blank %}
                  {{ block.settings.mobile_top_image | image_url: width: 1200 | image_tag: widths: '100, 480, 750, 1000, 1200', sizes: '(min-width: 769px) 1px, 100vw', loading: 'lazy', fetchpriority: hero_img_priority, alt: block.settings.mobile_top_image.alt }}
                {% endif %}
              </div>
              <div class="hero-side">
                {% if block.settings.mobile_bottom_type == 'video' and block.settings.mobile_bottom_video != blank %}
                  <video autoplay loop muted playsinline data-hero-video data-video-src="{{ block.settings.mobile_bottom_video.sources[0].url }}"></video>
                {% elsif block.settings.mobile_bottom_image != blank %}
                  {{ block.settings.mobile_bottom_image | image_url: width: 1200 | image_tag: widths: '100, 480, 750, 1000, 1200', sizes: '(min-width: 769px) 1px, 100vw', loading: 'lazy', fetchpriority: hero_img_priority, alt: block.settings.mobile_bottom_image.alt }}
                {% endif %}
              </div>
            </div>
          {% else %}
            <div class="hero-media hero-full">
              {% if block.settings.mobile_full_type == 'video' and block.settings.mobile_full_video != blank %}
                <video autoplay loop muted playsinline data-hero-video data-video-src="{{ block.settings.mobile_full_video.sources[0].url }}"></video>
              {% elsif block.settings.mobile_full_image != blank %}
                {{ block.settings.mobile_full_image | image_url: width: 1200 | image_tag: widths: '100, 480, 750, 1000, 1200', sizes: '(min-width: 769px) 1px, 100vw', loading: 'lazy', fetchpriority: hero_img_priority, alt: block.settings.mobile_full_image.alt }}
              {% endif %}
            </div>
          {% endif %}
        </div>
        <div class="hero-content content-align-{{ block.settings.content_alignment }}{% if block.settings.button_style_override %} hero-content--custom-cta{% endif %}" style="
          --heading-color: {{ block.settings.heading_color }};
          --subtext-color: {{ block.settings.subtext_color }};
          --heading-size-desktop: {{ block.settings.heading_size_desktop }}px;
          --heading-size-mobile: {{ block.settings.heading_size_mobile }}px;
          --subtext-size-desktop: {{ block.settings.subtext_size_desktop }}px;
          --subtext-size-mobile: {{ block.settings.subtext_size_mobile }}px;
          --heading-font-weight: {{ block.settings.heading_font_weight }};
          --subtext-font-weight: {{ block.settings.subtext_font_weight }};
          --heading-subtext-spacing: {{ block.settings.heading_subtext_spacing }}px;
          --hero-button-gap-desktop: {{ block.settings.button_gap_desktop | default: 18 }}px;
          --hero-button-gap-mobile: {{ block.settings.button_gap_mobile | default: 18 }}px;
          {% if block.settings.button_style_override %}
            --hero-cta-bg: {{ block.settings.button_custom_background }};
            --hero-cta-text: {{ block.settings.button_custom_text }};
            --hero-cta-border: {{ block.settings.button_custom_border }};
            --hero-cta-hover-bg: {{ block.settings.button_custom_hover_background }};
            --hero-cta-hover-text: {{ block.settings.button_custom_hover_text }};
            --hero-cta-hover-border: {{ block.settings.button_custom_hover_border }};
            --hero-cta-radius: {{ block.settings.button_custom_radius }}px;
            --hero-cta-border-width: {{ block.settings.button_custom_border_width }}px;
          {% endif %}
        ">
          {% if block.settings.heading != blank %}<h2 class="hero-heading">{{ block.settings.heading }}</h2>{% endif %}
          {% if block.settings.subtext != blank %}<div class="hero-subtext">{{ block.settings.subtext }}</div>{% endif %}
          {% if block.settings.button_label != blank %}
            {% assign hero_button_url = block.settings.button_link %}
            {% if hero_button_url contains '/collections/all' and hero_button_url contains 'view=black-friday' %}
              {% unless hero_button_url contains 'sort_by=' %}{% capture hero_button_url %}{% render 'zootify-sale-url' %}{% endcapture %}{% endunless %}
            {% endif %}
            <a href="{{ hero_button_url | strip | escape }}" class="button hero-slide-cta">{{ block.settings.button_label }}</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <button type="button" class="hero-nav-button hero-nav-button--prev" aria-label="Previous banner" aria-controls="hero-track-{{ section.id }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <button type="button" class="hero-nav-button hero-nav-button--next" aria-label="Next banner" aria-controls="hero-track-{{ section.id }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  {% endif %}
  <div class="hero-dots">{% for block in section.blocks %}<span class="hero-dot{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}"></span>{% endfor %}</div>
</section>
<style>
.hero-dynamic {position:relative;height:650px;overflow:hidden}
.hero-slides {display:flex;width:100%;height:100%;transform:translate3d(0,0,0);transition:transform .8s cubic-bezier(.22,1,.36,1);will-change:transform}
.hero-slide {position:relative;flex:0 0 100%;width:100%;min-width:100%;height:100%;opacity:1}
.hero-slide.is-active {opacity:1;z-index:1}
.hero-desktop,.hero-mobile,.hero-media,.hero-side,.hero-full {width:100%;height:100%}
.hero-media {display:flex}
.hero-split .hero-side {width:50%}
.hero-side img,.hero-side video,.hero-full img,.hero-full video {width:100%;height:100%;object-fit:cover}
.hero-content {position:absolute;z-index:3;max-width:700px;padding:20px}
.hero-heading {margin:0 0 var(--heading-subtext-spacing,12px);color:var(--heading-color,#fff);font-size:var(--heading-size-desktop,48px);font-weight:var(--heading-font-weight,700);line-height:1.1}
.hero-subtext {margin-bottom:var(--hero-button-gap-desktop,18px);color:var(--subtext-color,#fff);font-size:var(--subtext-size-desktop,16px);font-weight:var(--subtext-font-weight,400);line-height:1.5}
.hero-content .button {display:inline-flex;align-items:center;justify-content:center}
.hero-dynamic .hero-content--custom-cta .hero-slide-cta.button {background:var(--hero-cta-bg);color:var(--hero-cta-text);border:var(--hero-cta-border-width) solid var(--hero-cta-border);border-radius:var(--hero-cta-radius)}
.hero-dynamic .hero-content--custom-cta .hero-slide-cta.button:hover {background:var(--hero-cta-hover-bg);color:var(--hero-cta-hover-text);border-color:var(--hero-cta-hover-border)}
.content-align-left {text-align:left;align-items:flex-start}
.content-align-center {text-align:center;align-items:center}
.content-align-right {text-align:right;align-items:flex-end}
@media(min-width:769px){.hero-mobile{display:none}.hero-content{bottom:40px;left:40px}.content-align-center{left:50%;transform:translateX(-50%)}.content-align-right{left:auto;right:40px}}
@media(max-width:768px){.hero-dynamic{height:var(--mobile-hero-height,62vh)}.hero-desktop{display:none}.hero-split{flex-direction:column}.hero-split .hero-side{width:100%;height:50%}.hero-content{bottom:20px;left:20px;right:20px;padding:0;max-width:calc(100% - 40px)}.hero-heading{font-size:var(--heading-size-mobile,28px)}.hero-subtext{font-size:var(--subtext-size-mobile,14px);margin-bottom:var(--hero-button-gap-mobile,18px)}.content-align-center{left:50%;transform:translateX(-50%);text-align:center}.content-align-right{left:auto;right:20px;text-align:right}}
.hero-nav-button{position:absolute;top:50%;z-index:6;display:flex;align-items:center;justify-content:center;width:38px;height:38px;padding:0;border:1px solid rgba(1,21,30,.14);border-radius:50%;background:rgba(255,255,255,.92);color:#01151E;appearance:none;box-shadow:0 4px 14px rgba(0,0,0,.10);cursor:pointer;opacity:0;pointer-events:none;transform:translateY(-50%);transition:opacity 180ms ease,transform 180ms ease,background-color 180ms ease}
.hero-nav-button--prev{left:18px}.hero-nav-button--next{right:18px}.hero-nav-button svg{width:18px;height:18px}
.hero-dynamic:hover .hero-nav-button,.hero-dynamic:focus-within .hero-nav-button{opacity:1;pointer-events:auto}
.hero-nav-button:hover{background:#fff;transform:translateY(-50%) scale(1.06)}.hero-nav-button:active{transform:translateY(-50%) scale(.96)}
@media(max-width:768px){.hero-nav-button{display:none}.hero-slides{touch-action:pan-y}}
.hero-dots{position:absolute;bottom:20px;right:16px;display:flex;gap:6px;z-index:5}
.hero-dot{width:6px;height:6px;background:rgba(0,0,0,.3);border-radius:50%;cursor:pointer;transition:.3s ease}
.hero-dot.is-active{width:18px;background:#000;border-radius:6px}
</style>
<script>
(() => {
  const sectionId = 'hero-{{ section.id }}';
  function initHeroSlider() {
    const section = document.getElementById(sectionId);
    if (!section || section.dataset.sliderInitialized === 'true') return;
    const track = section.querySelector('.hero-slides');
    const slides = Array.from(section.querySelectorAll('.hero-slide:not(.hero-slide-clone)'));
    const dots = Array.from(section.querySelectorAll('.hero-dot'));
    const prevButton = section.querySelector('.hero-nav-button--prev');
    const nextButton = section.querySelector('.hero-nav-button--next');
    if (!track || slides.length === 0) return;
    section.dataset.sliderInitialized = 'true';
    const slideCount = slides.length;
    const interval = {{ section.settings.interval_seconds | default: 6 | times: 1000 }};
    let index = 0;
    let physicalIndex = slideCount > 1 ? 1 : 0;
    let isTransitioning = false;
    let autoplayTimer = null;
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTime = 0;
    function prepareClone(slide, cloneClass) {
      const clone = slide.cloneNode(true);
      clone.classList.remove('is-active');
      clone.classList.add('hero-slide-clone', cloneClass);
      clone.removeAttribute('data-index');
      clone.removeAttribute('data-shopify-editor-block');
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelectorAll('a, button, input, select, textarea, [tabindex]').forEach(element => element.setAttribute('tabindex', '-1'));
      return clone;
    }
    if (slideCount > 1) {
      track.insertBefore(prepareClone(slides[slideCount - 1], 'hero-slide-clone--last'), track.firstChild);
      track.appendChild(prepareClone(slides[0], 'hero-slide-clone--first'));
    }
    function updateActiveState(activeIndex) {
      slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === activeIndex));
      dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === activeIndex));
    }
    function moveTo(targetPhysicalIndex, animate = true) {
      // A one-slide hero is static. Hover/focus transitions must never translate it.
      if (slideCount < 2) {
        physicalIndex = 0;
        track.style.transition = 'none';
        track.style.transform = 'translate3d(0, 0, 0)';
        return;
      }
      if (!animate) track.style.transition = 'none';
      else track.style.removeProperty('transition');
      track.style.transform = `translate3d(-${targetPhysicalIndex * 100}%, 0, 0)`;
    }
    function goTo(targetIndex, direction = 'direct') {
      if (slideCount < 2 || isTransitioning) return;
      const normalizedIndex = (targetIndex + slideCount) % slideCount;
      isTransitioning = true;
      index = normalizedIndex;
      if (direction === 'next' && normalizedIndex === 0) physicalIndex = slideCount + 1;
      else if (direction === 'prev' && normalizedIndex === slideCount - 1) physicalIndex = 0;
      else physicalIndex = normalizedIndex + 1;
      updateActiveState(index);
      moveTo(physicalIndex, true);
    }
    function next() { goTo(index === slideCount - 1 ? 0 : index + 1, 'next'); }
    function prev() { goTo(index === 0 ? slideCount - 1 : index - 1, 'prev'); }
    function stopAutoplay() {
      if (autoplayTimer) {
        window.clearInterval(autoplayTimer);
        autoplayTimer = null;
        section.heroAutoplayTimer = null;
      }
    }
    function startAutoplay() {
      stopAutoplay();
      if (slideCount < 2) return;
      autoplayTimer = window.setInterval(next, interval);
      section.heroAutoplayTimer = autoplayTimer;
    }
    track.addEventListener('transitionend', event => {
      // transitionend bubbles from buttons and other descendants. Only this track's
      // own completed transform may run the looping-slide reset.
      if (event.target !== track || event.propertyName !== 'transform' || slideCount < 2) return;
      if (physicalIndex === slideCount + 1) {
        physicalIndex = 1;
        moveTo(physicalIndex, false);
        track.offsetHeight;
        track.style.removeProperty('transition');
      } else if (physicalIndex === 0) {
        physicalIndex = slideCount;
        moveTo(physicalIndex, false);
        track.offsetHeight;
        track.style.removeProperty('transition');
      }
      isTransitioning = false;
    });
    dots.forEach(dot => dot.addEventListener('click', () => {
      const targetIndex = Number(dot.dataset.slide);
      if (targetIndex === index || isTransitioning) return;
      if (index === slideCount - 1 && targetIndex === 0) goTo(0, 'next');
      else if (index === 0 && targetIndex === slideCount - 1) goTo(slideCount - 1, 'prev');
      else goTo(targetIndex, 'direct');
      startAutoplay();
    }));
    if (prevButton) prevButton.addEventListener('click', () => { prev(); startAutoplay(); });
    if (nextButton) nextButton.addEventListener('click', () => { next(); startAutoplay(); });
    track.addEventListener('touchstart', event => {
      if (slideCount < 2 || !window.matchMedia('(max-width: 768px)').matches) return;
      const touch = event.changedTouches[0];
      if (!touch) return;
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchStartTime = Date.now();
      stopAutoplay();
    }, {passive: true});
    track.addEventListener('touchend', event => {
      if (slideCount < 2 || !window.matchMedia('(max-width: 768px)').matches) return;
      const touch = event.changedTouches[0];
      if (!touch) { startAutoplay(); return; }
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;
      const elapsed = Date.now() - touchStartTime;
      const isHorizontalSwipe = Math.abs(deltaX) >= 45 && Math.abs(deltaX) > Math.abs(deltaY) * 1.15 && elapsed <= 900;
      if (isHorizontalSwipe && !isTransitioning) { if (deltaX < 0) next(); else prev(); }
      startAutoplay();
    }, {passive: true});
    track.addEventListener('touchcancel', startAutoplay, {passive: true});

    /* ── Load video sources only for the visible viewport ── */
    const isMobile = () => window.matchMedia('(max-width: 768px)').matches;
    const visibleContainer = isMobile() ? '.hero-mobile' : '.hero-desktop';
    section.querySelectorAll(`${visibleContainer} video[data-hero-video]`).forEach(video => {
      const src = video.dataset.videoSrc;
      if (src && !video.getAttribute('src')) {
        video.src = src;
        video.load();
      }
    });

    /* On resize/orientation change, load the newly-visible viewport's videos */
    let heroResizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(heroResizeTimer);
      heroResizeTimer = setTimeout(() => {
        const container = isMobile() ? '.hero-mobile' : '.hero-desktop';
        section.querySelectorAll(`${container} video[data-hero-video]`).forEach(video => {
          const src = video.dataset.videoSrc;
          if (src && !video.getAttribute('src')) {
            video.src = src;
            video.load();
            const p = video.play();
            if (p?.catch) p.catch(() => {});
          }
        });
      }, 300);
    });

    updateActiveState(0);
    moveTo(physicalIndex, false);
    track.offsetHeight;
    if (slideCount > 1) track.style.removeProperty('transition');
    startAutoplay();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHeroSlider);
  else initHeroSlider();
  document.addEventListener('shopify:section:load', event => {
    const loadedSection = event.target.id === sectionId ? event.target : event.target.querySelector(`#${sectionId}`);
    if (loadedSection) { delete loadedSection.dataset.sliderInitialized; initHeroSlider(); }
  });
  document.addEventListener('shopify:section:unload', event => {
    const unloadedSection = event.target.id === sectionId ? event.target : event.target.querySelector(`#${sectionId}`);
    if (unloadedSection && unloadedSection.heroAutoplayTimer) window.clearInterval(unloadedSection.heroAutoplayTimer);
  });
})();
</script>
{% schema %}
