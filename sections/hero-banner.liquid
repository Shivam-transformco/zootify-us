{% comment %}
  Hero – Dynamic Slider
  Desktop + Mobile
  Image + Video (Shopify video upload)

  CHANGE:
  Added backend-controlled mobile banner height.
  Desktop height remains unchanged.
  Slide images/videos/text/buttons/settings remain unchanged.
{% endcomment %}

{% comment %} CHANGE: Added --mobile-hero-height variable from section setting {% endcomment %}
<section
  id="hero-{{ section.id }}"
  class="hero-dynamic"
  style="--mobile-hero-height: {{ section.settings.mobile_banner_height | default: 62 }}vh;"
>

  <div class="hero-slides">
    {% for block in section.blocks %}

      <div class="hero-slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>

        <!-- DESKTOP -->
        <div class="hero-desktop">
          {% if block.settings.desktop_layout == 'split' %}
            <div class="hero-media hero-split">

              <div class="hero-side">
                {% if block.settings.desktop_left_type == 'video' and block.settings.desktop_left_video != blank %}
                  {{ block.settings.desktop_left_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
                {% elsif block.settings.desktop_left_image != blank %}
                  <img src="{{ block.settings.desktop_left_image | image_url }}" alt="">
                {% endif %}
              </div>

              <div class="hero-side">
                {% if block.settings.desktop_right_type == 'video' and block.settings.desktop_right_video != blank %}
                  {{ block.settings.desktop_right_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
                {% elsif block.settings.desktop_right_image != blank %}
                  <img src="{{ block.settings.desktop_right_image | image_url }}" alt="">
                {% endif %}
              </div>

            </div>
          {% else %}
            <div class="hero-media hero-full">
              {% if block.settings.desktop_full_type == 'video' and block.settings.desktop_full_video != blank %}
                {{ block.settings.desktop_full_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
              {% elsif block.settings.desktop_full_image != blank %}
                <img src="{{ block.settings.desktop_full_image | image_url }}" alt="">
              {% endif %}
            </div>
          {% endif %}
        </div>

        <!-- MOBILE -->
        <div class="hero-mobile">
          {% if block.settings.mobile_layout == 'split' %}
            <div class="hero-media hero-split">

              <div class="hero-side">
                {% if block.settings.mobile_top_type == 'video' and block.settings.mobile_top_video != blank %}
                  {{ block.settings.mobile_top_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
                {% elsif block.settings.mobile_top_image != blank %}
                  <img src="{{ block.settings.mobile_top_image | image_url }}" alt="">
                {% endif %}
              </div>

              <div class="hero-side">
                {% if block.settings.mobile_bottom_type == 'video' and block.settings.mobile_bottom_video != blank %}
                  {{ block.settings.mobile_bottom_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
                {% elsif block.settings.mobile_bottom_image != blank %}
                  <img src="{{ block.settings.mobile_bottom_image | image_url }}" alt="">
                {% endif %}
              </div>

            </div>
          {% else %}
            <div class="hero-media hero-full">
              {% if block.settings.mobile_full_type == 'video' and block.settings.mobile_full_video != blank %}
                {{ block.settings.mobile_full_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
              {% elsif block.settings.mobile_full_image != blank %}
                <img src="{{ block.settings.mobile_full_image | image_url }}" alt="">
              {% endif %}
            </div>
          {% endif %}
        </div>

        <!-- CONTENT -->
        <div
          class="hero-content content-align-{{ block.settings.content_alignment }}"
          style="
            --heading-color: {{ block.settings.heading_color }};
            --subtext-color: {{ block.settings.subtext_color }};

            --heading-size-desktop: {{ block.settings.heading_size_desktop }}px;
            --heading-size-mobile: {{ block.settings.heading_size_mobile }}px;

            --subtext-size-desktop: {{ block.settings.subtext_size_desktop }}px;
            --subtext-size-mobile: {{ block.settings.subtext_size_mobile }}px;

            --heading-font-weight: {{ block.settings.heading_font_weight }};
            --subtext-font-weight: {{ block.settings.subtext_font_weight }};

            --heading-subtext-spacing: {{ block.settings.heading_subtext_spacing }}px;
          "
        >

          {% if block.settings.heading != blank %}
            <h2 class="hero-heading">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.subtext != blank %}
            <div class="hero-subtext">
              {{ block.settings.subtext }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link }}" class="button">
              {{ block.settings.button_label }}
            </a>
          {% endif %}

        </div>

      </div>
    {% endfor %}
  </div>

  <!-- DOTS -->
  <div class="hero-dots">
    {% for block in section.blocks %}
      <span class="hero-dot{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}"></span>
    {% endfor %}
  </div>

</section>

<style>

.hero-dynamic {
  position: relative;
  height: 650px;
  overflow: hidden;
}

.hero-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity .6s ease;
}

.hero-slide.is-active {
  opacity: 1;
  z-index: 1;
}

.hero-desktop,
.hero-mobile,
.hero-media,
.hero-side,
.hero-full {
  width: 100%;
  height: 100%;
}

.hero-media {
  display: flex;
}

.hero-split .hero-side {
  width: 50%;
}

.hero-side img,
.hero-side video,
.hero-full img,
.hero-full video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* CONTENT */

.hero-content {
  position: absolute;
  z-index: 3;
  max-width: 700px;
  padding: 20px;
}

.hero-heading {
  margin: 0 0 var(--heading-subtext-spacing, 12px);
  color: var(--heading-color, #fff);
  font-size: var(--heading-size-desktop, 48px);
  font-weight: var(--heading-font-weight, 700);
  line-height: 1.1;
}

.hero-subtext {
  margin-bottom: 18px;
  color: var(--subtext-color, #fff);
  font-size: var(--subtext-size-desktop, 16px);
  font-weight: var(--subtext-font-weight, 400);
  line-height: 1.5;
}

.hero-content .button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ALIGNMENTS */

.content-align-left {
  text-align: left;
  align-items: flex-start;
}

.content-align-center {
  text-align: center;
  align-items: center;
}

.content-align-right {
  text-align: right;
  align-items: flex-end;
}

/* DESKTOP POSITION */

@media (min-width: 769px) {

  .hero-mobile {
    display: none;
  }

  .hero-content {
    bottom: 40px;
    left: 40px;
  }

  .content-align-center {
    left: 50%;
    transform: translateX(-50%);
  }

  .content-align-right {
    left: auto;
    right: 40px;
  }

}

/* MOBILE */

@media (max-width: 768px) {

  /* CHANGE: Mobile hero height is now controlled from Shopify backend */
  .hero-dynamic {
    height: var(--mobile-hero-height, 62vh);
  }

  .hero-desktop {
    display: none;
  }

  .hero-split {
    flex-direction: column;
  }

  .hero-split .hero-side {
    width: 100%;
    height: 50%;
  }

  .hero-content {
    bottom: 20px;
    left: 20px;
    right: 20px;
    padding: 0;
    max-width: calc(100% - 40px);
  }

  .hero-heading {
    font-size: var(--heading-size-mobile, 28px);
  }

  .hero-subtext {
    font-size: var(--subtext-size-mobile, 14px);
  }

  .content-align-center {
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
  }

  .content-align-right {
    left: auto;
    right: 20px;
    text-align: right;
  }

}

/* DOTS */

.hero-dots {
  position: absolute;
  bottom: 20px;
  right: 16px;
  display: flex;
  gap: 6px;
  z-index: 5;
}

.hero-dot {
  width: 6px;
  height: 6px;
  background: rgba(0,0,0,.3);
  border-radius: 50%;
  cursor: pointer;
  transition: .3s ease;
}

.hero-dot.is-active {
  width: 18px;
  background: #000;
  border-radius: 6px;
}

</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const section = document.getElementById('hero-{{ section.id }}');
  if (!section) return;

  const slides = section.querySelectorAll('.hero-slide');
  const dots = section.querySelectorAll('.hero-dot');

  let index = 0;

  function go(i) {
    slides[index].classList.remove('is-active');
    dots[index].classList.remove('is-active');

    index = i;

    slides[index].classList.add('is-active');
    dots[index].classList.add('is-active');
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      go(+dot.dataset.slide);
    });
  });

  setInterval(() => {
    go((index + 1) % slides.length);
  }, {{ section.settings.interval | default: 6000 }});

});
</script>

{% schema %}
{
  "name": "Hero – Dynamic",
  "settings": [
    {
      "type": "range",
      "id": "interval",
      "label": "Slide interval (ms)",
      "min": 4000,
      "max": 9000,
      "step": 500,
      "default": 6000
    },
    {
      "type": "range",
      "id": "mobile_banner_height",
      "label": "Mobile banner height",
      "min": 45,
      "max": 95,
      "step": 1,
      "unit": "vh",
      "default": 62
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [

        {
          "type": "header",
          "content": "Content"
        },

        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },

        {
          "type": "textarea",
          "id": "subtext",
          "label": "Sub text"
        },

        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },

        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#ffffff"
        },

        {
          "type": "color",
          "id": "subtext_color",
          "label": "Sub text color",
          "default": "#ffffff"
        },

        {
          "type": "range",
          "id": "heading_size_desktop",
          "label": "Heading size desktop",
          "min": 16,
          "max": 100,
          "step": 1,
          "default": 48
        },

        {
          "type": "range",
          "id": "heading_size_mobile",
          "label": "Heading size mobile",
          "min": 12,
          "max": 80,
          "step": 1,
          "default": 28
        },

        {
          "type": "range",
          "id": "subtext_size_desktop",
          "label": "Sub text size desktop",
          "min": 10,
          "max": 60,
          "step": 1,
          "default": 16
        },

        {
          "type": "range",
          "id": "subtext_size_mobile",
          "label": "Sub text size mobile",
          "min": 10,
          "max": 40,
          "step": 1,
          "default": 14
        },

        {
          "type": "range",
          "id": "heading_font_weight",
          "label": "Heading font weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 700
        },

        {
          "type": "range",
          "id": "subtext_font_weight",
          "label": "Subtext font weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 400
        },

        {
          "type": "range",
          "id": "heading_subtext_spacing",
          "label": "Spacing between heading & subtext",
          "min": 0,
          "max": 60,
          "step": 1,
          "default": 12
        },

        {
          "type": "select",
          "id": "desktop_layout",
          "label": "Desktop layout",
          "options": [
            { "value": "split", "label": "Split" },
            { "value": "full", "label": "Full" }
          ],
          "default": "split"
        },

        {
          "type": "select",
          "id": "desktop_left_type",
          "label": "Desktop left media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },

        {
          "type": "image_picker",
          "id": "desktop_left_image",
          "label": "Desktop left image"
        },

        {
          "type": "video",
          "id": "desktop_left_video",
          "label": "Desktop left video"
        },

        {
          "type": "select",
          "id": "desktop_right_type",
          "label": "Desktop right media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },

        {
          "type": "image_picker",
          "id": "desktop_right_image",
          "label": "Desktop right image"
        },

        {
          "type": "video",
          "id": "desktop_right_video",
          "label": "Desktop right video"
        },

        {
          "type": "select",
          "id": "desktop_full_type",
          "label": "Desktop full media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },

        {
          "type": "image_picker",
          "id": "desktop_full_image",
          "label": "Desktop full image"
        },

        {
          "type": "video",
          "id": "desktop_full_video",
          "label": "Desktop full video"
        },

        {
          "type": "select",
          "id": "mobile_layout",
          "label": "Mobile layout",
          "options": [
            { "value": "full", "label": "Full" },
            { "value": "split", "label": "Split" }
          ],
          "default": "full"
        },

        {
          "type": "select",
          "id": "mobile_top_type",
          "label": "Mobile top media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },

        {
          "type": "image_picker",
          "id": "mobile_top_image",
          "label": "Mobile top image"
        },

        {
          "type": "video",
          "id": "mobile_top_video",
          "label": "Mobile top video"
        },

        {
          "type": "select",
          "id": "mobile_bottom_type",
          "label": "Mobile bottom media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },

        {
          "type": "image_picker",
          "id": "mobile_bottom_image",
          "label": "Mobile bottom image"
        },

        {
          "type": "video",
          "id": "mobile_bottom_video",
          "label": "Mobile bottom video"
        },

        {
          "type": "select",
          "id": "mobile_full_type",
          "label": "Mobile full media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },

        {
          "type": "image_picker",
          "id": "mobile_full_image",
          "label": "Mobile full image"
        },

        {
          "type": "video",
          "id": "mobile_full_video",
          "label": "Mobile full video"
        },

        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }

      ]
    }
  ],
  "presets": [
    {
      "name": "Hero – Dynamic"
    }
  ]
}
{% endschema %}