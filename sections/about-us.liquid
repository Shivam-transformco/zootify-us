<script>
  (() => {
    if (customElements.get('premium-media-hero')) return;

    class PremiumMediaHero extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;

        this.track = this.querySelector('.pmh__track');
        this.slides = Array.from(this.querySelectorAll('.pmh__slide'));
        this.dots = Array.from(this.querySelectorAll('[data-pmh-dot]'));
        this.previousButton = this.querySelector('[data-pmh-prev]');
        this.nextButton = this.querySelector('[data-pmh-next]');
        this.currentIndex = Math.max(
          0,
          this.slides.findIndex((slide) => slide.classList.contains('is-active'))
        );

        this.transitionType = this.dataset.transition || 'fade';
        this.intervalDuration = Number(this.dataset.interval) || 6000;
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.autoplayEnabled =
          this.dataset.autoplay === 'true' &&
          this.slides.length > 1 &&
          !this.reducedMotion &&
          !(window.Shopify && window.Shopify.designMode);

        this.pointerStartX = null;
        this.timer = null;

        this.onPrevious = () => this.goTo(this.currentIndex - 1, true);
        this.onNext = () => this.goTo(this.currentIndex + 1, true);
        this.onKeydown = (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            this.goTo(this.currentIndex - 1, true);
          }

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            this.goTo(this.currentIndex + 1, true);
          }
        };

        this.onPointerDown = (event) => {
          this.pointerStartX = event.clientX;
        };

        this.onPointerUp = (event) => {
          if (this.pointerStartX === null) return;

          const distance = event.clientX - this.pointerStartX;
          this.pointerStartX = null;

          if (Math.abs(distance) < 50) return;
          if (distance > 0) this.goTo(this.currentIndex - 1, true);
          if (distance < 0) this.goTo(this.currentIndex + 1, true);
        };

        this.onMouseEnter = () => this.stopAutoplay();
        this.onMouseLeave = () => this.startAutoplay();
        this.onFocusIn = () => this.stopAutoplay();
        this.onFocusOut = () => {
          window.requestAnimationFrame(() => {
            if (!this.contains(document.activeElement)) this.startAutoplay();
          });
        };

        this.onResize = () => {
          window.clearTimeout(this.resizeTimer);
          this.resizeTimer = window.setTimeout(() => this.syncVideos(), 120);
        };

        this.onBlockSelect = (event) => {
          const blockId = event.detail && event.detail.blockId;
          if (!blockId) return;

          const index = this.slides.findIndex(
            (slide) => slide.dataset.blockId === blockId
          );

          if (index >= 0) {
            this.stopAutoplay();
            this.goTo(index, false);
          }
        };

        if (this.previousButton) {
          this.previousButton.addEventListener('click', this.onPrevious);
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', this.onNext);
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            this.goTo(Number(dot.dataset.pmhDot), true);
          });
        });

        this.addEventListener('keydown', this.onKeydown);
        this.addEventListener('pointerdown', this.onPointerDown, { passive: true });
        this.addEventListener('pointerup', this.onPointerUp, { passive: true });
        this.addEventListener('mouseenter', this.onMouseEnter);
        this.addEventListener('mouseleave', this.onMouseLeave);
        this.addEventListener('focusin', this.onFocusIn);
        this.addEventListener('focusout', this.onFocusOut);
        window.addEventListener('resize', this.onResize);
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        this.goTo(this.currentIndex, false);
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.clearTimeout(this.resizeTimer);

        if (this.previousButton) {
          this.previousButton.removeEventListener('click', this.onPrevious);
        }

        if (this.nextButton) {
          this.nextButton.removeEventListener('click', this.onNext);
        }

        this.removeEventListener('keydown', this.onKeydown);
        this.removeEventListener('pointerdown', this.onPointerDown);
        this.removeEventListener('pointerup', this.onPointerUp);
        this.removeEventListener('mouseenter', this.onMouseEnter);
        this.removeEventListener('mouseleave', this.onMouseLeave);
        this.removeEventListener('focusin', this.onFocusIn);
        this.removeEventListener('focusout', this.onFocusOut);
        window.removeEventListener('resize', this.onResize);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      normalizeIndex(index) {
        const count = this.slides.length;
        if (!count) return 0;
        return ((index % count) + count) % count;
      }

      goTo(index, restartAutoplay) {
        if (!this.slides.length) return;

        this.currentIndex = this.normalizeIndex(index);

        this.slides.forEach((slide, slideIndex) => {
          const active = slideIndex === this.currentIndex;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });

        if (this.transitionType === 'slide' && this.track) {
          this.track.style.transform =
            `translate3d(-${this.currentIndex * 100}%, 0, 0)`;
        }

        this.dots.forEach((dot, dotIndex) => {
          dot.setAttribute(
            'aria-current',
            dotIndex === this.currentIndex ? 'true' : 'false'
          );
        });

        this.syncVideos();

        if (restartAutoplay) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      syncVideos() {
        this.slides.forEach((slide, slideIndex) => {
          slide.querySelectorAll('video').forEach((video) => {
            const visible =
              slideIndex === this.currentIndex &&
              video.offsetParent !== null;

            if (visible) {
              const playPromise = video.play();
              if (playPromise && typeof playPromise.catch === 'function') {
                playPromise.catch(() => {});
              }
            } else {
              video.pause();
            }
          });
        });
      }

      startAutoplay() {
        if (!this.autoplayEnabled || this.timer) return;

        this.timer = window.setInterval(() => {
          this.goTo(this.currentIndex + 1, false);
        }, this.intervalDuration);
      }

      stopAutoplay() {
        if (!this.timer) return;
        window.clearInterval(this.timer);
        this.timer = null;
      }
    }

    customElements.define('premium-media-hero', PremiumMediaHero);
  })();
</script>

