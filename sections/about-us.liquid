            type="button"
            class="pmh__dot"
            data-pmh-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="PMH-track-{{ section.id }}"
          >
            <span class="pmh__sr-only">Slide {{ forloop.index }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
