{% comment %}
Shop by Category – Uses Theme Default Spacing
Mobile slider enabled
Arrow hover: #01161e
{% endcomment %}

<section class="shop-category-{{ section.id }} section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="category-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="category-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="category-card">

          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.title }}"
              class="category-image"
              loading="lazy"
            >
          {% endif %}

          <div class="category-overlay"></div>

          <div class="category-content">
            <h3>{{ block.settings.title }}</h3>
            <div class="arrow-circle">→</div>
          </div>

        </a>
      {% endfor %}
    </div>

  </div>
</section>

<style>

/* HEADING */
.shop-category-{{ section.id }} .category-heading{
  margin-top:50px;
  font-size:24px;
  font-weight:700;
  margin-bottom:25px;
}

/* DESKTOP GRID */
.shop-category-{{ section.id }} .category-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(280px,1fr));
  margin-bottom:50px;
  gap:28px;
}

/* CARD */
.shop-category-{{ section.id }} .category-card{
  position:relative;
  width:100%;
  aspect-ratio:450 / 700; /* reduced card size */
  border-radius:4px;
  overflow:hidden;
  display:block;
  text-decoration:none;
}

/* IMAGE */
.shop-category-{{ section.id }} .category-image{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .5s ease;
}

/* OVERLAY */
.shop-category-{{ section.id }} .category-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(
    to top,
    rgba(0,0,0,0.65) 0%,
    rgba(0,0,0,0.35) 35%,
    transparent 65%
  );
}

/* CONTENT */
.shop-category-{{ section.id }} .category-content{
  position:absolute;
  bottom:18px;
  left:18px;
  right:18px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  color:#fff;
}

.shop-category-{{ section.id }} .category-content h3{
  margin:0;
  font-size:25px;
  font-weight:700;
}

/* ARROW */
.shop-category-{{ section.id }} .arrow-circle{
  width:42px;
  height:42px;
  border:2px solid #6ac857;
  color:#6ac857;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px;
  transition:.25s;
}

/* HOVER */
.shop-category-{{ section.id }} .category-card:hover .category-image{
  transform:scale(1.05);
}

.shop-category-{{ section.id }} .category-card:hover .arrow-circle{
  background:#01161e;
  color:#fff;
  border-color:#01161e;
}

/* MOBILE SLIDER */
@media(max-width:768px){

  .shop-category-{{ section.id }} .category-grid{
    display:flex !important;
    overflow-x:auto;
    gap:16px;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
    padding-bottom:10px;
  }

  .shop-category-{{ section.id }} .category-grid::-webkit-scrollbar{
    display:none;
  }

  .shop-category-{{ section.id }} .category-card{
    flex:0 0 65%; /* smaller mobile cards */
    scroll-snap-align:start;
  }

  .shop-category-{{ section.id }} .category-heading{
    font-size:20px;
  }
}

</style>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category"
    }
  ]
}
{% endschema %}
