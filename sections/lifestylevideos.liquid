<!-- sections/marquee-hover-section.liquid -->

<section class="marquee-section section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="marquee-container" id="marqueeContainer">
      <div class="marquee-track" id="marqueeTrack">

        {% for block in section.blocks %}
          <div class="image-block" {{ block.shopify_attributes }}>
            <div class="image-wrapper">

              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >
              {% else %}
                <div class="placeholder-image">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              <div class="buy-now-overlay">
                {% if block.settings.product != blank %}
                  <button
                    class="button button--primary shop-now-btn"
                    data-product-handle="{{ block.settings.product.handle }}">
                    SHOP NOW
                  </button>
                {% else %}
                  <button class="button button--primary" disabled>
                    SHOP NOW
                  </button>
                {% endif %}
              </div>

            </div>
          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</section>

<style>

.marquee-section .section-heading{
  font-size:24px;
  font-weight:bold;
  margin-bottom:25px;
}

.marquee-container{
  width:100%;
  overflow-x:auto;
  overflow-y:hidden;
  cursor:grab;
  scrollbar-width:none;
}

.marquee-container::-webkit-scrollbar{
  display:none;
}

.marquee-container.dragging{
  cursor:grabbing;
}

.marquee-track{
  display:flex;
  gap:10px;
  width:max-content;
}

.image-block{
  flex:0 0 auto;
  width:399px;
  height:554px;
}

.image-wrapper{
  position:relative;
  width:100%;
  height:100%;
  overflow:hidden;
  border-radius:4px;
}

.image-wrapper img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .35s ease;
}

.placeholder-image{
  width:100%;
  height:100%;
  background:#f5f5f5;
  display:flex;
  align-items:center;
  justify-content:center;
}

.buy-now-overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.7);
  display:flex;
  align-items:flex-end;
  justify-content:flex-start;
  padding:0 0 30px 24px;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease;
}

.image-wrapper:hover img{
  transform:scale(1.05);
}

.image-wrapper:hover .buy-now-overlay{
  opacity:1;
  pointer-events:auto;
}

/* MOBILE */
@media(max-width:768px){

  .image-block{
    flex:0 0 75%;
    max-width:252px;
    height:auto;
  }

  .image-wrapper{
    height:auto;
  }

  .image-wrapper img{
    height:auto;
  }
}

</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const container = document.getElementById('marqueeContainer');
  const track = document.getElementById('marqueeTrack');

  if(!container || !track) return;

  /* DUPLICATE CONTENT FOR INFINITE LOOP */
  track.innerHTML += track.innerHTML;

  /* AUTO SCROLL */
  let speed = 0.4;
  let isDragging = false;
  let startX;
  let scrollLeft;

  function autoScroll(){
    if(!isDragging){
      container.scrollLeft += speed;

      if(container.scrollLeft >= track.scrollWidth / 2){
        container.scrollLeft = container.scrollLeft - track.scrollWidth / 2;
      }
    }
    requestAnimationFrame(autoScroll);
  }

  autoScroll();

  /* DRAG SCROLL */
  container.addEventListener('mousedown', (e)=>{
    isDragging = true;
    container.classList.add('dragging');
    startX = e.pageX - container.offsetLeft;
    scrollLeft = container.scrollLeft;
  });

  container.addEventListener('mouseleave', stopDrag);
  container.addEventListener('mouseup', stopDrag);

  function stopDrag(){
    isDragging = false;
    container.classList.remove('dragging');
  }

  container.addEventListener('mousemove', (e)=>{
    if(!isDragging) return;
    e.preventDefault();
    const x = e.pageX - container.offsetLeft;
    const walk = (x - startX) * 1.5;
    container.scrollLeft = scrollLeft - walk;
  });

  /* SHOP NOW CLICK (EVENT DELEGATION FIX) */
  document.addEventListener('click', function(e){
    const btn = e.target.closest('.shop-now-btn');
    if(!btn) return;

    const handle = btn.dataset.productHandle;
    if(handle){
      window.location.href = '/products/' + handle;
    }
  });

});
</script>

{% schema %}
{
  "name": "Marquee Hover Section",
  "max_blocks": 15,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image Block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Hover Section"
    }
  ]
}
{% endschema %}
