          });
          this.observer.observe(this);
        }

        if (this.isEditor) {
          this.listen(document, 'shopify:block:select', (event) => {
            const id = String(event.detail?.blockId || '');
            const index = this.slides.findIndex((slide) => slide.dataset.blockId === id);
            if (index !== -1) this.show(index, true);
          });
          this.listen(document, 'shopify:section:select', (event) => {
            if (String(event.detail?.sectionId) === this.dataset.sectionId) {
              this.userPaused = true;
              this.stop();
              this.updateToggle();
            }
          });
        }
        this.schedule();
      }

      listen(target, type, handler) {
        target.addEventListener(type, handler, { signal: this.abortController.signal });
      }

      stop() {
        if (this.timer) clearTimeout(this.timer);
        this.timer = null;
      }

      schedule() {
        this.stop();
        if (!this.initialized || !this.autoRotate || this.userPaused || this.isEditor ||
            this.hovered || !this.inView || this.hidden || !this.isConnected ||
            document.hidden || !this.getClientRects().length) return;
        this.timer = setTimeout(() => {
          this.timer = null;
          this.show(this.index + 1, false);
        }, this.interval);
      }

      show(next, manual) {
        if (!this.slides?.length) return;
        const index = (next + this.slides.length) % this.slides.length;
        if (manual) this.userPaused = true;
        // A focused message must never be automatically removed from focus.
        if (!manual && this.slides[this.index].contains(document.activeElement)) {
          this.userPaused = true;
          this.updateToggle();
          this.stop();
          return;
        }
        this.slides.forEach((slide, i) => {
          const active = i === index;
          slide.inert = !active;
          slide.setAttribute('aria-hidden', String(!active));
          slide.classList.toggle('is-active', active);
        });
        this.index = index;
        this.updateToggle();
        if (manual && this.status && !this.isEditor) {
          const label = (this.dataset.positionLabel || 'Announcement {current} of {total}')
            .replace('{current}', String(index + 1)).replace('{total}', String(this.slides.length));
          // innerText includes only the currently visible desktop/mobile copy.
          const text = this.slides[index].querySelector('.zab__copy')?.innerText.trim() || '';
          this.status.textContent = `${label}: ${text}`;
        }
        this.schedule();
      }

      updateToggle() {
        const paused = this.userPaused || this.isEditor;
        this.toggleAttribute('data-paused', paused);
        if (this.toggleButton) {
          this.toggleButton.setAttribute('aria-label', paused ? this.dataset.playLabel : this.dataset.pauseLabel);
