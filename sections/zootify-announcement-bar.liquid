      isStoredDismissal() {
        if (!this.querySelector('[data-action="close"]')) return false;
        try {
          const key = this.dataset.storageKey;
          if (this.dataset.dismissMode === 'session') return sessionStorage.getItem(key) === 'dismissed';
          if (this.dataset.dismissMode === 'days') {
            const until = Number(localStorage.getItem(key));
            if (Number.isFinite(until) && until > Date.now()) return true;
            if (until) localStorage.removeItem(key);
          }
        } catch (_) { /* Blocked storage does not prevent using the bar. */ }
        return false;
      }

      dismiss() {
        if (this.isEditor) return;
        const hadFocus = this.contains(document.activeElement);
        try {
          const key = this.dataset.storageKey;
          if (this.dataset.dismissMode === 'session') sessionStorage.setItem(key, 'dismissed');
          if (this.dataset.dismissMode === 'days') {
            const days = Math.max(1, Math.min(30, Number(this.dataset.dismissDays) || 7));
            localStorage.setItem(key, String(Date.now() + days * 86400000));
          }
        } catch (_) { /* Dismiss for this page even when storage is blocked. */ }
        this.stop();
        this.hidden = true;
        if (this.wrapper) this.wrapper.hidden = true;

        // If the close button had keyboard focus, continue into the following
        // section instead of leaving focus in a hidden element.
        if (hadFocus && this.wrapper) {
          let sibling = this.wrapper.nextElementSibling;
          while (sibling) {
            const focusable = Array.from(sibling.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex="0"]'))
              .find((node) => node.getClientRects().length && getComputedStyle(node).visibility !== 'hidden');
            if (focusable) { focusable.focus({ preventScroll: true }); break; }
            sibling = sibling.nextElementSibling;
          }
        }
      }

      disconnectedCallback() {
        if (this.startFrame) cancelAnimationFrame(this.startFrame);
        this.stop();
        this.abortController?.abort();
        this.observer?.disconnect();
        this.observer = null;
        this.initialized = false;
      }
    }
    customElements.define(tagName, ZootifyAnnouncement);
  })();
