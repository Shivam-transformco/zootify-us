{%- liquid
  assign s = section.settings
  assign message_count = 0
  for block in section.blocks
    if block.type == 'countdown' or block.settings.text != blank or block.settings.mobile_text != blank
      assign message_count = message_count | plus: 1
    endif
  endfor
  assign bf_announcements_enabled = false
  if settings.zbf_enabled and settings.zbf_announcement_enabled
    assign bf_announcements_enabled = true
  endif
  assign show_bar = s.enable_bar
  if s.page_scope == 'home' and request.page_type != 'index'
    assign show_bar = false
  elsif s.page_scope == 'except_home' and request.page_type == 'index'
    assign show_bar = false
  endif
  if message_count == 0
    assign show_bar = false
  endif
  assign rail_slots = 0
  assign rail_gaps = 0
  if message_count > 1
    assign rail_slots = 1
    if s.show_close
      assign rail_slots = 2
      assign rail_gaps = 1
    endif
  elsif s.show_close
    assign rail_slots = 1
  endif
  assign custom_font = s.custom_font
  assign custom_font_desktop = custom_font | font_modify: 'weight', s.weight_desktop | default: custom_font
  assign custom_font_mobile = custom_font | font_modify: 'weight', s.weight_mobile | default: custom_font
  assign custom_font_link = custom_font | font_modify: 'weight', s.link_weight | default: custom_font
-%}
{%- capture dismissal_content -%}
  {{- s.dismiss_revision | json -}}|{{- localization.language.iso_code | json -}}|
  {%- for block in section.blocks -%}{{- block.id | json -}}|{{- block.settings.text | json -}}|{{- block.settings.mobile_text | json -}}|{{- block.settings.link | json -}}|{{- block.settings.link_label | json -}}|{{- block.settings.mobile_link_label | json -}}|{{- block.type | json -}}|{{- block.settings.timer_source | json -}}|{{- block.settings.prefix | json -}}|{{- block.settings.live_prefix | json -}}|{{- block.settings.mobile_prefix | json -}}|{{- block.settings.mobile_live_prefix | json -}}|{{- block.settings.custom_date | json -}}|{{- block.settings.custom_time | json -}}|{{- block.settings.custom_timezone | json -}}|{{- block.settings.display_phase | json -}}|{{- block.settings.standard_offer | json -}}|{%- endfor -%}
{%- endcapture -%}
{%- assign dismissal_hash = dismissal_content | sha256 | slice: 0, 20 -%}
{% style %}
  {% if s.font_source == 'custom' and show_bar %}
    {{ custom_font_desktop | font_face: font_display: 'swap' }}
    {% if custom_font_mobile != custom_font_desktop %}{{ custom_font_mobile | font_face: font_display: 'swap' }}{% endif %}
    {% if custom_font_link != custom_font_desktop %}{{ custom_font_link | font_face: font_display: 'swap' }}{% endif %}
  {% endif %}
  #shopify-section-{{ section.id }} { position: relative; inset: auto; z-index: auto; width: 100%; min-width: 0; min-height: 0; height: auto; margin: 0; padding: 0; border: 0; background: transparent; box-shadow: none; overflow: visible; }
  {% if s.sticky_bar and show_bar %}
    #shopify-section-{{ section.id }} { position: sticky; top: 0; z-index: calc(var(--layer-sticky, 20) + 1); }
    #shopify-section-{{ section.id }} ~ .header-section:has(> #header-component[sticky='always']),
    #shopify-section-{{ section.id }} ~ .header-section:has(> #header-component[sticky='scroll-up'][data-sticky-state='active']) { top: max(0px, calc(var(--zab-sticky-height, 0px) - 1px)); }
  {% endif %}
  #shopify-section-{{ section.id }}[hidden] { display: none !important; }
  #ZootifyAnnouncement-{{ section.id }} {
    --zab-background: {{ s.background_gradient | default: s.background_color }};
    --zab-text: {{ s.text_color }}; --zab-link: {{ s.link_color }}; --zab-link-hover: {{ s.link_hover_color }};
    --zab-icon: {{ s.icon_color }}; --zab-controls: {{ s.control_color }};
    --zab-control-hover: {{ s.control_color | color_modify: 'alpha', 0.12 }};
    --zab-border: {{ s.border_color }}; --zab-border-width: {{ s.border_width }}px;
    --zab-size: {{ s.size_desktop }}px; --zab-weight: {{ s.weight_desktop }};
    --zab-leading: {{ s.line_height_desktop | divided_by: 10.0 }}; --zab-tracking: {{ s.letter_spacing_desktop }}px;
    --zab-pad-top: {{ s.padding_top_desktop }}px; --zab-pad-bottom: {{ s.padding_bottom_desktop }}px;
    --zab-pad-side: {{ s.padding_side_desktop }}px; --zab-min-height: {{ s.min_height_desktop }}px;
    --zab-align: {{ s.align_desktop }};
    --zab-justify: {% case s.align_desktop %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
    --zab-icon-size: {{ s.icon_size_desktop }}px; --zab-icon-gap: {{ s.icon_gap }}px;
    --zab-link-weight: {{ s.link_weight }};
    --zab-content-width: {% if s.content_width == 'full' %}100%{% else %}{{ s.max_width }}px{% endif %};
    --zab-rail-slots: {{ rail_slots }}; --zab-rail-gaps: {{ rail_gaps }}; --zab-control-size: 36px; --zab-control-gap: 4px;
    --zab-case: {% if s.uppercase %}uppercase{% else %}none{% endif %};
    --zab-underline: {% if s.underline_links %}underline{% else %}none{% endif %};
    {% case s.font_source %}
      {% when 'custom' %}--zab-family: {{ custom_font.family }}, {{ custom_font.fallback_families }};
      {% when 'heading' %}--zab-family: var(--font-heading--family, inherit);
      {% else %}--zab-family: var(--font-body--family, inherit);
    {% endcase %}
  }
  @media (max-width: 749px) {
    #ZootifyAnnouncement-{{ section.id }} {
      --zab-size: {{ s.size_mobile }}px; --zab-weight: {{ s.weight_mobile }};
      --zab-leading: {{ s.line_height_mobile | divided_by: 10.0 }}; --zab-tracking: {{ s.letter_spacing_mobile }}px;
      --zab-pad-top: {{ s.padding_top_mobile }}px; --zab-pad-bottom: {{ s.padding_bottom_mobile }}px;
      --zab-pad-side: {{ s.padding_side_mobile }}px; --zab-min-height: {{ s.min_height_mobile }}px;
      --zab-align: {{ s.align_mobile }};
      --zab-justify: {% case s.align_mobile %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
      --zab-icon-size: {{ s.icon_size_mobile }}px; --zab-control-size: 44px; --zab-control-gap: 2px;
    }
    {% if s.devices == 'desktop' %}#shopify-section-{{ section.id }} { display: none; }{% endif %}
  }
  {% if s.devices == 'mobile' %}@media (min-width: 750px) { #shopify-section-{{ section.id }} { display: none; } }{% endif %}
  {% unless show_bar %}{% unless request.design_mode %}#shopify-section-{{ section.id }} { display: none; }{% endunless %}{% endunless %}
{% endstyle %}
{%- if show_bar -%}
  <script src="{{ 'zootify-announcement-merged.js' | asset_url }}" type="module"></script>
  <zootify-announcement-v1 id="ZootifyAnnouncement-{{ section.id }}" class="zab" role="region" aria-label="{{ s.region_label | default: 'Store announcements' | escape }}"
    data-section-id="{{ section.id }}" data-sticky="{{ s.sticky_bar }}" data-auto-rotate="{{ s.auto_rotate }}" data-interval="{{ s.rotation_interval }}" data-transition="{{ s.transition }}" data-design-mode="{{ request.design_mode }}"
    data-bf-announcement="{{ bf_announcements_enabled }}" data-dismiss-mode="{{ s.dismiss_memory }}" data-dismiss-days="{{ s.dismiss_days }}"
    data-storage-key="zootify-announcement-v1:{{ shop.permanent_domain | escape }}:{{ section.id }}:{{ dismissal_hash }}" data-position-label="{{ s.position_label | escape }}">
    <div class="zab__inner"><div class="zab__layout">
      <div class="zab__rail zab__rail--start">
        {% if message_count > 1 %}<button type="button" class="zab__button" data-action="previous" aria-label="{{ s.previous_label | default: 'Previous announcement' | escape }}" aria-controls="ZootifyMessages-{{ section.id }}"><svg class="zab__direction-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button>{% endif %}
      </div>
      <div id="ZootifyMessages-{{ section.id }}" class="zab__viewport" aria-live="off">
        {%- assign initial_slide_found = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'countdown' -%}
            <div class="zab__slide" data-message data-message-kind="countdown" data-block-id="{{ block.id }}" aria-hidden="true" hidden inert {{ block.shopify_attributes }}><div class="zab__message"><div class="zab__copy zab__campaign-countdown">{% render 'zootify-bf-countdown', placement: 'announcement', compact: true, timer_settings: block.settings %}</div></div></div>
          {%- elsif block.settings.text != blank or block.settings.mobile_text != blank -%}
            {%- liquid
              assign desktop_text = block.settings.text | default: block.settings.mobile_text
              assign mobile_text = block.settings.mobile_text | default: desktop_text
              assign desktop_link_label = block.settings.link_label
              assign mobile_link_label = block.settings.mobile_link_label | default: desktop_link_label
              assign display_phase = block.settings.display_phase | default: 'always'
              assign initially_active = false
              if display_phase == 'always' and initial_slide_found == false
                assign initially_active = true
                assign initial_slide_found = true
              endif
            -%}
            <div class="zab__slide{% if initially_active %} is-active{% endif %}" data-message data-message-kind="message" data-block-id="{{ block.id }}" data-display-phase="{{ display_phase }}" {% if block.settings.standard_offer %}data-bf-standard{% endif %} aria-hidden="{% if initially_active %}false{% else %}true{% endif %}"{% unless initially_active %} inert{% endunless %}{% if display_phase != 'always' %} hidden{% endif %} {{ block.shopify_attributes }}>
              <div class="zab__message">
                {% if block.settings.icon != 'none' %}<svg class="zab__message-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'truck' %}<path d="M3 6h11v11H3zM14 10h4l3 4v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
                    {% when 'package' %}<path d="m12 3 9 5v9l-9 5-9-5V8l9-5Zm-9 5 9 5 9-5M12 13v9M7.5 5.5l9 5"/>
                    {% when 'shield' %}<path d="m12 3 8 3v6c0 5-8 9-8 9S4 17 4 12V6l8-3Z"/><path d="m8 12 3 3 5-6"/>
                    {% when 'gift' %}<path d="M3 8h18v4H3zM5 12v9h14v-9M12 8v13"/><path d="M12 8H8a3 3 0 1 1 3-3l1 3Zm0 0h4a3 3 0 1 0-3-3l-1 3Z"/>
                    {% when 'sparkle' %}<path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z"/>
                    {% when 'check' %}<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
                  {% endcase %}
                </svg>{% endif %}
                <p class="zab__copy">
                  <span class="zab__desktop-copy">{{- desktop_text -}}{% if block.settings.link != blank and desktop_link_label != blank %} <a class="zab__cta" href="{{ block.settings.link | escape }}"{% if block.settings.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ desktop_link_label | escape }}{% if block.settings.new_tab %}<span class="zab__sr-only"> ({{ s.new_tab_label | default: 'opens in a new tab' | escape }})</span>{% endif %}</a>{% endif %}</span>
                  <span class="zab__mobile-copy">{{- mobile_text -}}{% if block.settings.link != blank and mobile_link_label != blank %} <a class="zab__cta" href="{{ block.settings.link | escape }}"{% if block.settings.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ mobile_link_label | escape }}{% if block.settings.new_tab %}<span class="zab__sr-only"> ({{ s.new_tab_label | default: 'opens in a new tab' | escape }})</span>{% endif %}</a>{% endif %}</span>
                </p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="zab__rail zab__rail--end">
        {% if message_count > 1 %}<button type="button" class="zab__button" data-action="next" aria-label="{{ s.next_label | default: 'Next announcement' | escape }}" aria-controls="ZootifyMessages-{{ section.id }}"><svg class="zab__direction-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button>{% endif %}
        {% if s.show_close %}<button type="button" class="zab__button" data-action="close" aria-label="{{ s.close_label | default: 'Dismiss announcement bar' | escape }}"{% if request.design_mode %} disabled{% endif %}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>{% endif %}
      </div>
    </div></div>
    <span class="zab__sr-only" data-status role="status" aria-live="polite" aria-atomic="true"></span>
  </zootify-announcement-v1>
  {% unless request.design_mode %}<noscript><style>#ZootifyAnnouncement-{{ section.id }}:not([data-ready]) .zab__layout{grid-template-columns:minmax(0,1fr)}#ZootifyAnnouncement-{{ section.id }}:not([data-ready]) .zab__slide:not(.is-active),#ZootifyAnnouncement-{{ section.id }}:not([data-ready]) .zab__rail{display:none}</style></noscript>{% endunless %}
{%- elsif request.design_mode -%}<div class="zab-editor-note">This announcement bar is hidden. Check its visibility settings and message blocks.</div>{%- endif -%}
{% stylesheet %}
  .zab,.zab *,.zab *::before,.zab *::after{box-sizing:border-box}
  .zab{display:block;position:relative;width:100%;max-width:100%;margin:0;padding:0;background:var(--zab-background);color:var(--zab-text);border:0;border-bottom:var(--zab-border-width) solid var(--zab-border);font-family:var(--zab-family);font-size:var(--zab-size);font-weight:var(--zab-weight);line-height:var(--zab-leading);letter-spacing:var(--zab-tracking);text-transform:var(--zab-case)}
  .zab[hidden],.zab [hidden]{display:none!important}
  .zab .zab__inner{display:block;width:100%;max-width:var(--zab-content-width);margin-inline:auto;padding-inline:var(--zab-pad-side)}
  .zab .zab__layout{display:grid;--zab-rail:calc(var(--zab-control-size)*var(--zab-rail-slots) + var(--zab-control-gap)*var(--zab-rail-gaps));grid-template-columns:var(--zab-rail) minmax(0,1fr) var(--zab-rail);align-items:center;min-width:0;min-height:var(--zab-min-height)}
  .zab .zab__viewport{display:grid;min-width:0;width:100%}
  .zab .zab__slide{grid-area:1/1;display:flex;min-width:0;width:100%;align-items:center;padding-block:var(--zab-pad-top) var(--zab-pad-bottom);visibility:hidden;opacity:0;pointer-events:none}
  .zab .zab__slide.is-active{visibility:visible;opacity:1;pointer-events:auto}
  .zab[data-ready][data-transition='fade'] .zab__slide.is-active{animation:zab-message-in 180ms ease-out}
  .zab .zab__message{display:flex;align-items:center;justify-content:var(--zab-justify);gap:var(--zab-icon-gap);width:100%;min-width:0}
  .zab .zab__copy{display:block;min-width:0;max-width:100%;margin:0;padding:0;font:inherit;color:inherit;line-height:inherit;letter-spacing:inherit;text-align:var(--zab-align);text-transform:inherit;white-space:normal;overflow-wrap:anywhere;text-wrap:pretty}
  .zab .zab__copy strong,.zab .zab__copy b{font-weight:bolder}.zab .zab__copy em,.zab .zab__copy i{font-style:italic}
  .zab .zab__campaign-countdown{display:flex;align-items:center;justify-content:var(--zab-justify);width:100%;min-width:0;font-variant-numeric:tabular-nums;white-space:nowrap}
  .zab .zab__campaign-countdown>*{max-width:100%}
  .zab .zab__copy a{display:inline;padding:0;min-height:0;min-width:0;border:0;border-radius:0;background:none;box-shadow:none;font:inherit;font-weight:var(--zab-link-weight);color:var(--zab-link);text-decoration-line:var(--zab-underline);text-decoration-thickness:1px;text-underline-offset:3px;white-space:normal;overflow-wrap:anywhere;transition:color 160ms ease}
  .zab .zab__copy .zab__cta{margin-inline-start:.45em}.zab .zab__copy a:hover{color:var(--zab-link-hover);text-decoration-line:underline}
  .zab .zab__copy a:focus-visible{outline:2px solid currentColor;outline-offset:3px;border-radius:2px}
  .zab .zab__desktop-copy{display:inline}.zab .zab__mobile-copy{display:none}
  .zab .zab__message-icon{display:block;flex:0 0 var(--zab-icon-size);width:var(--zab-icon-size);height:var(--zab-icon-size);color:var(--zab-icon)}
  .zab .zab__rail{display:flex;visibility:hidden;pointer-events:none;align-items:center;gap:var(--zab-control-gap);min-width:0}
  .zab[data-ready] .zab__rail{visibility:visible;pointer-events:auto}.zab .zab__rail--start{justify-content:flex-end}.zab .zab__rail--end{justify-content:flex-start}
  .zab .zab__button{appearance:none;display:inline-flex;flex:0 0 var(--zab-control-size);align-items:center;justify-content:center;position:relative;width:var(--zab-control-size);height:var(--zab-control-size);min-width:0;min-height:0;margin:0;padding:0;border:0;border-radius:3px;background:transparent;color:var(--zab-controls);box-shadow:none;font:inherit;line-height:1;letter-spacing:0;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;transition:background-color 160ms ease}
  .zab .zab__button::before,.zab .zab__button::after{content:none}.zab .zab__button:hover{background:var(--zab-control-hover)}.zab .zab__button:focus-visible{outline:2px solid currentColor;outline-offset:-3px}.zab .zab__button:disabled{opacity:.5;cursor:default}
  .zab .zab__button svg{display:block;width:18px;height:18px;flex:0 0 18px}.zab:dir(rtl) .zab__direction-icon{transform:rotate(180deg)}
  .zab .zab__sr-only{position:absolute!important;width:1px!important;height:1px!important;margin:-1px!important;padding:0!important;border:0!important;overflow:hidden!important;clip-path:inset(50%)!important;white-space:nowrap!important}
  .zab-editor-note{margin:0;padding:14px 20px;border:1px dashed #777;background:#f4f4f4;color:#222;text-align:center;font:13px/1.5 sans-serif}
  @media(max-width:749px){.zab .zab__desktop-copy{display:none}.zab .zab__mobile-copy{display:inline}}
  @keyframes zab-message-in{from{opacity:0}to{opacity:1}}
  @media(prefers-reduced-motion:reduce){.zab[data-ready][data-transition='fade'] .zab__slide.is-active{animation:none}.zab .zab__button,.zab .zab__copy a{transition:none}}
{% endstylesheet %}
{% schema %}
{"name":"ZOOTIFY announcement bar","tag":"div","class":"zootify-announcement-section","limit":1,"enabled_on":{"groups":["header"]},"max_blocks":12,"settings":[{"type":"header","content":"Placement and visibility"},{"type":"paragraph","content":"Keep above the Header section. Sticky mode keeps announcements visible with the logo and navigation directly below. Black Friday reminders and existing message blocks are retained."},{"type":"checkbox","id":"enable_bar","label":"Show announcement bar","default":true},{"type":"checkbox","id":"sticky_bar","label":"Keep announcement bar sticky on scroll","default":true,"info":"Automatically adjusts the header offset when text wraps, the bar is hidden, or a reminder finishes."},{"type":"select","id":"page_scope","label":"Pages","options":[{"value":"all","label":"All storefront pages"},{"value":"home","label":"Homepage only"},{"value":"except_home","label":"All except homepage"}],"default":"all"},{"type":"select","id":"devices","label":"Devices","options":[{"value":"both","label":"Desktop and mobile"},{"value":"desktop","label":"Desktop only"},{"value":"mobile","label":"Mobile only"}],"default":"both"},{"type":"header","content":"Multiple messages"},{"type":"paragraph","content":"Message and Countdown reminder blocks retain their order. Inactive reminders and campaign-specific messages are hidden automatically."},{"type":"checkbox","id":"auto_rotate","label":"Rotate messages automatically","default":false},{"type":"range","id":"rotation_interval","label":"Seconds per message","min":5,"max":15,"step":1,"default":7,"unit":"s","visible_if":"{{ section.settings.auto_rotate }}"},{"type":"select","id":"transition","label":"Message transition","options":[{"value":"fade","label":"Subtle fade"},{"value":"none","label":"No animation"}],"default":"fade"},{"type":"paragraph","content":"Rotation pauses on hover, keyboard focus and manual navigation. No pause/play icon is shown. Selecting a block pauses rotation while editing."},{"type":"header