            "custom_liquid_qVJ4ya": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "disabled": true,
              "settings": {
                "custom_liquid": "<style>\n.custom-info-container {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  font-size: 16px;\n  color: #000;\n}\n\n/* Shipping container */\n.custom-shipping-box {\n  width: 80%;              /* desktop width */\n  max-width: 80%;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px;\n  border: 1px solid #e6e6e6;\n  border-radius: 4px;\n  font-size: 14px;\n  background: #fafafa;\n}\n\n/* Truck icon image */\n.custom-truck-icon {\n  width: 20px;\n  height: 20px;\n  object-fit: contain;\n  flex-shrink: 0;\n}\n\n/* Mobile: reset to default */\n@media (max-width: 768px) {\n  .custom-shipping-box {\n    width: 100%;\n    max-width: 100%;\n  }\n}\n</style>\n\n<div class=\"custom-info-container\">\n  <div class=\"custom-shipping-box\">\n    <img \n      src=\"https://cdn.shopify.com/s/files/1/0674/4136/1049/files/fast-delivery.png?v=1770551575\" \n      alt=\"Fast Delivery\" \n      class=\"custom-truck-icon\"\n    >\n    <span>Delivery within 4–5 days.</span>\n  </div>\n</div>"
              },
              "blocks": {}
            },
            "custom_liquid_biYFPc": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"offer-wrapper\">\n  <div class=\"offer-heading\">Active offers</div>\n\n  <div class=\"offer-carousel\">\n    <div class=\"offer-track\">\n\n      <div class=\"offer-box\">\n        <span class=\"offer-text\">\n          Get an additional 5% OFF on Prepaid orders\n        </span>\n      </div>\n\n      <div class=\"offer-box\">\n        <span class=\"offer-text\">\n          Free shipping on purchase above ₹1,000\n        </span>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"offer-dots\"></div>\n</div>\n\n<style>\n.offer-wrapper {\n  max-width: 450px;\n  margin: 12px 0;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n}\n\n.offer-heading {\n  font-size: 18px;\n  margin-bottom: 12px;\n  color: #1a1a1a;\n  font-weight: 700;\n  padding-left: 2px\n}\n\n.offer-carousel {\n  overflow: hidden;\n}\n\n.offer-track {\n  display: flex;\n  transition: transform 0.45s ease;\n}\n\n/* MATCHES IMAGE: Light grey background card with rounded corners, no borders */\n.offer-box {\n  min-width: 100%;\n  display: flex;\n  align-items: center;\n  padding: 16px 20px;\n  border: none;\n  border-radius: 12px;\n  background: #f8f8f8;\n  box-sizing: border-box;\n}\n\n.offer-text {\n  font-size: 14px;\n  font-weight: 400;\n  color: #1a1a1a;\n  letter-spacing: -0.1px;\n}\n\n.offer-dots {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 12px;\n}\n\n.offer-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #1a1a1a;\n  opacity: 0.2;\n  cursor: pointer;\n  transition: opacity 0.3s ease, background-color 0.3s ease;\n}\n\n.offer-dot.active {\n  background: #52ad4d;\n  opacity: 1;\n}\n\n@media (max-width: 600px) {\n  .offer-wrapper {\n    width: 100%;\n  }\n.offer-heading {\n  font-size: 16px;}\n  .offer-box {\n    padding: 14px 18px;\n  }\n  .offer-text {\n    font-size: 14px;\n  }\n}\n</style>\n\n<script>\n(function () {\n  const track = document.querySelector(\".offer-track\");\n  const slides = document.querySelectorAll(\".offer-box\");\n  const dotsContainer = document.querySelector(\".offer-dots\");\n\n  if (!track || slides.length === 0) return;\n\n  let currentIndex = 0;\n\n  slides.forEach((_, index) => {\n    const dot = document.createElement(\"span\");\n    dot.className = \"offer-dot\" + (index === 0 ? \" active\" : \"\");\n    dot.addEventListener(\"click\", () => moveToSlide(index));\n    dotsContainer.appendChild(dot);\n  });\n\n  const dots = document.querySelectorAll(\".offer-dot\");\n\n  function moveToSlide(index) {\n    track.style.transform = `translateX(-${index * 100}%)`;\n    dots.forEach(d => d.classList.remove(\"active\"));\n    dots[index].classList.add(\"active\");\n    currentIndex = index;\n  }\n\n  /* swipe support */\n  let touchStartX = 0;\n  track.addEventListener(\"touchstart\", e => { touchStartX = e.touches[0].clientX; }, { passive: true });\n  track.addEventListener(\"touchend\", e => {\n    const diff = touchStartX - e.changedTouches[0].clientX;\n    if (Math.abs(diff) > 40) moveToSlide(diff > 0 ? Math.min(currentIndex + 1, slides.length - 1) : Math.max(currentIndex - 1, 0));\n  }, { passive: true });\n\n  /* auto slide */\n  setInterval(() => {\n    currentIndex = (currentIndex + 1) % slides.length;\n    moveToSlide(currentIndex);\n  }, 4000);\n})();\n</script>"
              },
