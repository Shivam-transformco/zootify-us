            "custom_liquid_mrdyGn": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "disabled": true,
              "settings": {
                "custom_liquid": "{% if product.metafields.custom.upsell_products.value != blank %}\n\n<style>\n.buy-together-container{\n  width:100%;\n  margin-top:0px;\n}\n\n.buy-together-heading{\n  font-size:18px;\n  font-weight:600;\n  margin-bottom:14px;\n}\n\n.buy-together-list{\n  display:flex;\n  flex-direction:column;\n  gap:12px;\n}\n\n.buy-together-row{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  border:1px solid #e6e6e6;\n  border-radius:10px;\n  padding:12px;\n  background:#fff;\n}\n\n@media(min-width:769px){\n  .buy-together-row{\n    margin-right:20%;\n  }\n}\n\n@media(max-width:768px){\n  .buy-together-row{\n    margin-right:0;\n    padding:10px;\n  }\n}\n\n.buy-together-left{\n  display:flex;\n  align-items:center;\n  gap:14px;\n  flex:1;\n}\n\n.buy-together-image img{\n  width:70px;\n  height:70px;\n  object-fit:contain;\n  background:#f6f6f6;\n  border-radius:8px;\n}\n\n.buy-together-info{\n  display:flex;\n  flex-direction:column;\n  gap:6px;\n}\n\n.buy-together-title{\n  font-size:14px;\n  font-weight:500;\n}\n\n.buy-together-price{\n  font-size:14px;\n  font-weight:600;\n}\n\n.buy-together-btn{\n  border:1px solid #1F3C56;\n  color:#1F3C56;\n  background:transparent;\n  padding:8px 18px;\n  border-radius:25px;\n  font-size:13px;\n  cursor:pointer;\n}\n\n.buy-together-btn:hover{\n  background:#1F3C56;\n  color:#fff;\n}\n\n.buy-together-btn:disabled{\n  opacity:.6;\n  cursor:not-allowed;\n}\n</style>\n\n\n<div class=\"buy-together-container\">\n\n  <div class=\"buy-together-heading\">Build your stack</div>\n\n  <div class=\"buy-together-list\">\n\n    {% for upsell_product in product.metafields.custom.upsell_products.value %}\n    <div class=\"buy-together-row\">\n\n      <div class=\"buy-together-left\">\n\n        <div class=\"buy-together-image\">\n          <img\n            src=\"{{ upsell_product.featured_image | image_url: width: 200 }}\"\n            alt=\"{{ upsell_product.title }}\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"buy-together-info\">\n          <div class=\"buy-together-title\">\n            {{ upsell_product.title }}\n          </div>\n\n          <div class=\"buy-together-price\">\n            {{ upsell_product.price | money }}\n          </div>\n        </div>\n\n      </div>\n\n      <form method=\"post\" action=\"/cart/add\" class=\"upsell-form\">\n        <input type=\"hidden\" name=\"id\" value=\"{{ upsell_product.selected_or_first_available_variant.id }}\">\n        <button type=\"submit\" class=\"buy-together-btn\">+ ADD</button>\n      </form>\n\n    </div>\n    {% endfor %}\n\n  </div>\n</div>\n\n\n<script>\ndocument.querySelectorAll('.upsell-form').forEach(form => {\n\n  const btn = form.querySelector('.buy-together-btn');\n\n  btn.addEventListener('click', function(e){\n\n    e.preventDefault();\n    e.stopPropagation();\n\n    btn.disabled = true;\n    btn.innerText = \"Adding...\";\n\n    fetch('/cart/add.js', {\n      method: 'POST',\n      body: new FormData(form),\n      headers: { 'Accept': 'application/json' }\n    })\n    .then(response => response.json())\n    .then(() => {\n\n      /* Reload cart drawer content */\n      fetch('/?section_id=cart-drawer')\n        .then(res => res.text())\n        .then(html => {\n\n          const newDoc = new DOMParser().parseFromString(html, 'text/html');\n          const newDrawer = newDoc.querySelector('cart-drawer');\n          const currentDrawer = document.querySelector('cart-drawer');\n\n          if (currentDrawer && newDrawer) {\n            currentDrawer.innerHTML = newDrawer.innerHTML;\n\n            if (typeof currentDrawer.open === 'function') {\n              currentDrawer.open();\n            }\n          }\n\n        });\n\n      btn.innerText = \"Added ✓\";\n\n    })\n    .catch(() => {\n      btn.disabled = false;\n      btn.innerText = \"+ ADD\";\n    });\n\n  });\n\n});\n</script>\n\n{% endif %}"
              },
              "blocks": {}
            },
