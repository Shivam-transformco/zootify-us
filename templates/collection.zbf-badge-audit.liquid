{% layout none %}{% if theme.role == 'unpublished' %}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>ZOOTIFY badge check</title><style>body{font:14px/1.45 system-ui;margin:16px;color:#111}h1{font-size:20px;margin:0 0 8px}p{margin:8px 0}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.5 monospace;padding:12px;background:#f6f6f6;border:1px solid #ddd}#frames{overflow:hidden;width:100%}iframe{display:block;height:720px;max-width:none;border:1px solid #ccc;margin:16px 0}button{padding:10px 15px;background:#111;color:white;border:0;border-radius:4px}</style></head><body>
<h1>ZOOTIFY mobile badge check</h1><p>Keep this page open until both checks finish. This does not change the store, discounts or cart.</p><pre id="audit-result">Checking the two preview pages...</pre><button type="button" id="copy-report">Copy report</button><div id="frames"></div>
<script>
(function(){
const out=document.getElementById('audit-result'),box=document.getElementById('frames');const width=Math.min(390,window.innerWidth);const report={theme:{{theme.id|json}},browser:navigator.userAgent,parentWidth:window.innerWidth,hasSelector:CSS.supports('selector(:has(*))'),checks:{}};
function visible(e,w){if(!e)return false;const s=w.getComputedStyle(e),r=e.getBoundingClientRect();return s.display!=='none'&&s.visibility==='visible'&&Number(s.opacity)>0&&r.width>0&&r.height>0;}
function show(){let text='Theme: '+report.theme+'\nBrowser: '+report.browser+'\nPhone width: '+report.parentWidth+'\nSupports :has: '+report.hasSelector+'\n';for(const[key,t]of Object.entries(report.checks)){text+='\n'+key+':\n';if(t.error){text+=t.error+'\n';continue;}text+='Viewport: '+t.width+'\nB2G1 in page: '+t.badges+'\nB2G1 visible: '+t.visibleBadges+'\nNEW visible: '+t.visibleNew+'\nFirst badge: '+JSON.stringify(t.firstBadge)+'\n';}text+='\n'+(Object.keys(report.checks).length===2?'CHECK COMPLETE':'Checking...');out.textContent=text;}
function inspect(f,key){try{const w=f.contentWindow,d=f.contentDocument,b=[...d.querySelectorAll('.zbf-hero-deal-badge')],n=[...d.querySelectorAll('.product-badges__badge--new')],first=b[0],s=first?w.getComputedStyle(first):null,r=first?.getBoundingClientRect();report.checks[key]={url:w.location.href,width:w.innerWidth,badges:b.length,visibleBadges:b.filter(e=>visible(e,w)).length,visibleNew:n.filter(e=>visible(e,w)).length,firstBadge:s?{display:s.display,visibility:s.visibility,width:Math.round(r.width),height:Math.round(r.height),background:s.backgroundColor,top:s.top}:null};show();}catch(e){report.checks[key]={error:e.message};show()}}
for(const[key,path]of [['Sale collection','/collections/black-friday'],['Shared-preview collection','/collections/all?view=black-friday&sort_by=best-selling']]){const f=document.createElement('iframe');f.title=key;f.width=String(width);f.style.width=width+'px';f.src=new URL(path,location.origin).href;f.addEventListener('load',()=>{setTimeout(()=>inspect(f,key),2000);setTimeout(()=>inspect(f,key),6500)});box.append(f)}
document.getElementById('copy-report').addEventListener('click',async function(){try{await navigator.clipboard.writeText(JSON.stringify(report,null,2));this.textContent='Copied';}catch(e){this.textContent='Please screenshot the report above';}});show();setTimeout(()=>{if(Object.keys(report.checks).length<2){out.textContent+='\nA preview frame did not load. Please screenshot this result.'}},22000);
})();
</script></body></html>{% endif %}
