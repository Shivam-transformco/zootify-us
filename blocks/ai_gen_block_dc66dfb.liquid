{% doc %}
  @prompt
    Add a section for a heading and sub heading with all the necessary customisation , like alignement , font, colours, font weight etc. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-heading-block-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-heading-block__container-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-heading-block__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    {% if block.settings.heading_text_transform == 'uppercase' %}
      text-transform: uppercase;
    {% elsif block.settings.heading_text_transform == 'lowercase' %}
      text-transform: lowercase;
    {% elsif block.settings.heading_text_transform == 'capitalize' %}
      text-transform: capitalize;
    {% else %}
      text-transform: none;
    {% endif %}
  }

  .ai-heading-block__subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: {{ block.settings.subheading_line_height }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    {% if block.settings.subheading_text_transform == 'uppercase' %}
      text-transform: uppercase;
    {% elsif block.settings.subheading_text_transform == 'lowercase' %}
      text-transform: lowercase;
    {% elsif block.settings.subheading_text_transform == 'capitalize' %}
      text-transform: capitalize;
    {% else %}
      text-transform: none;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-heading-block__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-heading-block__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-heading-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-heading-block__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-heading-block__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-heading-block__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
