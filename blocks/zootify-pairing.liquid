{% doc %}
  Displays the configurable Pair Up With block in product information.
{% enddoc %}
{% render 'upsell-products', product: closest.product, context: 'product', presentation: 'pairing', pairing_settings: block.settings, component_id: block.id, section_id: section.id, editor_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "Pair Up With",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show pairing section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair Up With"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Optional supporting line"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products to pair",
      "limit": 8,
      "info": "Leave blank to use the product's Upsell products metafield, then the global Pair Up With selection."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_offer",
      "label": "Show connected offer message",
      "default": true,
      "info": "The real discount is maintained in Shopify Discounts. Offer controls are in Theme settings > Case offer."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop heading size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Spacing and shape"
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Space above",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Space below",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Space between products",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#01151e"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text",
      "default": "#68716e"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Product card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#e6e8e6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Offer accent",
      "default": "#507c38"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#01151e"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#6ac857"
    }
  ],
  "presets": [
    {
      "name": "Pair Up With"
    }
  ]
}
{% endschema %}
