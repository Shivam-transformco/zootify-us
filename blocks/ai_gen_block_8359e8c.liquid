          {{ block.settings.device_2 }}
        </button>
      {% endif %}
      {% if block.settings.device_3 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_3 }}"
          role="radio"
          aria-checked="false"
        >
          {{ block.settings.device_3 }}
        </button>
      {% endif %}
      {% if block.settings.device_4 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_4 }}"
          role="radio"
          aria-checked="false"
        >
          {{ block.settings.device_4 }}
        </button>
      {% endif %}
      {% if block.settings.device_5 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_5 }}"
          role="radio"
          aria-checked="false"
        >
          {{ block.settings.device_5 }}
        </button>
      {% endif %}
      {% if block.settings.device_6 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_6 }}"
          role="radio"
          aria-checked="false"
        >
          {{ block.settings.device_6 }}
        </button>
      {% endif %}
      {% if block.settings.device_7 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_7 }}"
          role="radio"
          aria-checked="false"
        >
          {{ block.settings.device_7 }}
        </button>
      {% endif %}
      {% if block.settings.device_8 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_8 }}"
          role="radio"
          aria-checked="false"
        >
          {{ block.settings.device_8 }}
        </button>
      {% endif %}
      {% if block.settings.device_9 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_9 }}"
          role="radio"
          aria-checked="false"
        >
          {{ block.settings.device_9 }}
        </button>
      {% endif %}
      {% if block.settings.device_10 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_10 }}"
          role="radio"
          aria-checked="false"
        >
          {{ block.settings.device_10 }}
        </button>
      {% endif %}
    </div>
  {% endif %}
</device-selector-{{ ai_gen_id }}>

<script>
  (function() {
    class DeviceSelector{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.selectedDevice = null;
      }

      connectedCallback() {
        this.displayStyle = '{{ block.settings.display_style }}';
        
        if (this.displayStyle === 'dropdown') {
          this.select = this.querySelector('.ai-device-selector__select-{{ ai_gen_id }}');
          this.select.addEventListener('change', this.handleDropdownChange.bind(this));
        } else {
          this.options = this.querySelectorAll('.ai-device-selector__option-{{ ai_gen_id }}');
          this.options.forEach(option => {
            option.addEventListener('click', this.handleOptionClick.bind(this));
          });
        }
      }

      handleDropdownChange(event) {
        this.selectedDevice = event.target.value;
        this.dispatchDeviceChangeEvent();
      }

      handleOptionClick(event) {
        const clickedOption = event.currentTarget;
        const device = clickedOption.dataset.device;

        this.options.forEach(option => {
          option.classList.remove('selected');
          option.setAttribute('aria-checked', 'false');
        });

        clickedOption.classList.add('selected');
        clickedOption.setAttribute('aria-checked', 'true');
        this.selectedDevice = device;
        this.dispatchDeviceChangeEvent();
      }

      dispatchDeviceChangeEvent() {
        const event = new CustomEvent('device-selected', {
          detail: { device: this.selectedDevice },
          bubbles: true
        });
        this.dispatchEvent(event);
      }
    }

    customElements.define('device-selector-{{ ai_gen_id }}', DeviceSelector{{ ai_gen_id }});
  })();
</script>

