{% doc %}
  @prompt
    add SELECT DEVICE option in phone vover product page only
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-device-selector-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    margin-bottom: 20px;
  }

  .ai-device-selector__label-{{ ai_gen_id }} {
    display: block;
    font-family: var(--font-subheading-family);
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    margin-bottom: 12px;
    text-transform: {{ block.settings.label_case }};
  }

  .ai-device-selector__dropdown-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-device-selector__select-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding }}px;
    font-family: var(--font-body-family);
    font-size: {{ block.settings.input_text_size }}px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background }};
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    cursor: pointer;
    appearance: none;
    transition: all 0.2s ease;
  }

  .ai-device-selector__select-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.input_hover_background }};
    border-color: {{ block.settings.input_hover_border_color }};
  }

  .ai-device-selector__select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-device-selector__icon-{{ ai_gen_id }} {
    position: absolute;
    right: {{ block.settings.input_padding }}px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: {{ block.settings.input_text_color }};
    width: 20px;
    height: 20px;
  }

  .ai-device-selector__options-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }

  .ai-device-selector__option-{{ ai_gen_id }} {
    padding: 10px 16px;
    font-family: var(--font-body-family);
    font-size: {{ block.settings.option_text_size }}px;
    color: {{ block.settings.option_text_color }};
    background-color: {{ block.settings.option_background }};
    border: {{ block.settings.option_border_width }}px solid {{ block.settings.option_border_color }};
    border-radius: {{ block.settings.option_border_radius }}px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }

  .ai-device-selector__option-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.option_hover_background }};
    border-color: {{ block.settings.option_hover_border_color }};
    color: {{ block.settings.option_hover_text_color }};
  }

  .ai-device-selector__option-{{ ai_gen_id }}.selected {
    background-color: {{ block.settings.option_selected_background }};
    border-color: {{ block.settings.option_selected_border_color }};
    color: {{ block.settings.option_selected_text_color }};
  }

  .ai-device-selector__option-{{ ai_gen_id }}.selected:hover {
    background-color: {{ block.settings.option_selected_hover_background }};
    border-color: {{ block.settings.option_selected_hover_border_color }};
    color: {{ block.settings.option_selected_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-device-selector-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<device-selector-{{ ai_gen_id }} class="ai-device-selector-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <label for="device-select-{{ ai_gen_id }}" class="ai-device-selector__label-{{ ai_gen_id }}">
    {{ block.settings.label_text }}
  </label>

  {% if block.settings.display_style == 'dropdown' %}
    <div class="ai-device-selector__dropdown-wrapper-{{ ai_gen_id }}">
      <select
        id="device-select-{{ ai_gen_id }}"
        class="ai-device-selector__select-{{ ai_gen_id }}"
        aria-label="{{ block.settings.label_text }}"
      >
        <option value="">{{ block.settings.placeholder_text }}</option>
        {% if block.settings.device_1 != blank %}
          <option value="{{ block.settings.device_1 }}">{{ block.settings.device_1 }}</option>
        {% endif %}
        {% if block.settings.device_2 != blank %}
          <option value="{{ block.settings.device_2 }}">{{ block.settings.device_2 }}</option>
        {% endif %}
        {% if block.settings.device_3 != blank %}
          <option value="{{ block.settings.device_3 }}">{{ block.settings.device_3 }}</option>
        {% endif %}
        {% if block.settings.device_4 != blank %}
          <option value="{{ block.settings.device_4 }}">{{ block.settings.device_4 }}</option>
        {% endif %}
        {% if block.settings.device_5 != blank %}
          <option value="{{ block.settings.device_5 }}">{{ block.settings.device_5 }}</option>
        {% endif %}
        {% if block.settings.device_6 != blank %}
          <option value="{{ block.settings.device_6 }}">{{ block.settings.device_6 }}</option>
        {% endif %}
        {% if block.settings.device_7 != blank %}
          <option value="{{ block.settings.device_7 }}">{{ block.settings.device_7 }}</option>
        {% endif %}
        {% if block.settings.device_8 != blank %}
          <option value="{{ block.settings.device_8 }}">{{ block.settings.device_8 }}</option>
        {% endif %}
        {% if block.settings.device_9 != blank %}
          <option value="{{ block.settings.device_9 }}">{{ block.settings.device_9 }}</option>
        {% endif %}
        {% if block.settings.device_10 != blank %}
          <option value="{{ block.settings.device_10 }}">{{ block.settings.device_10 }}</option>
        {% endif %}
      </select>
      <svg class="ai-device-selector__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    </div>
  {% else %}
    <div class="ai-device-selector__options-{{ ai_gen_id }}" role="radiogroup" aria-label="{{ block.settings.label_text }}">
      {% if block.settings.device_1 != blank %}
        <button
          type="button"
          class="ai-device-selector__option-{{ ai_gen_id }}"
          data-device="{{ block.settings.device_1 }}"
          role="radio"
          aria-checked="false"
