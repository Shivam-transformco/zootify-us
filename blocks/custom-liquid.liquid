

{%- capture custom_liquid_content -%}
  {{ block.settings.custom_liquid }}
{%- endcapture -%}
{%- assign custom_liquid_content_check = custom_liquid_content | strip -%}

<div{% if custom_liquid_content_check == blank %} class="zootify-custom-liquid--empty"{% endif %}>
  {{ custom_liquid_content }}
</div>

{% schema %}
{
  "name": "t:names.custom_liquid",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:settings.custom_liquid",
      "info": "t:info.custom_liquid"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}
