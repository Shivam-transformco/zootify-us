{% doc %}
  @prompt
    Add a "Select Device" dropdown/selector option inside the product Details block on the product page. The selector should allow customers to choose their device model (e.g., iPhone 17, iPhone 16, etc.) and should be visually prominent, fitting naturally within the product details section alongside other product information.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-device-selector-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
  }

  .ai-device-selector__label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    margin-bottom: 12px;
    font-family: var(--font-subheading-family);
  }

  .ai-device-selector__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-device-selector__select-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 40px 14px 16px;
    font-size: {{ block.settings.dropdown_text_size }}px;
    font-family: var(--font-body-family);
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    appearance: none;
    transition: all 0.2s ease;
  }

  .ai-device-selector__select-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-device-selector__select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 2px;
    border-color: {{ block.settings.focus_color }};
  }

  .ai-device-selector__icon-{{ ai_gen_id }} {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: {{ block.settings.text_color }};
    transition: transform 0.2s ease;
  }

  .ai-device-selector__select-{{ ai_gen_id }}:focus ~ .ai-device-selector__icon-{{ ai_gen_id }} {
    transform: translateY(-50%) rotate(180deg);
  }

  .ai-device-selector__selected-value-{{ ai_gen_id }} {
    margin-top: 12px;
    padding: 12px 16px;
    background-color: {{ block.settings.selected_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-size: 14px;
    color: {{ block.settings.selected_text_color }};
    display: none;
  }

  .ai-device-selector__selected-value-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-device-selector__selected-label-{{ ai_gen_id }} {
    font-weight: 600;
    margin-right: 8px;
  }

  @media screen and (max-width: 749px) {
    .ai-device-selector__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }

    .ai-device-selector__select-{{ ai_gen_id }} {
      font-size: {{ block.settings.dropdown_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<device-selector-{{ ai_gen_id }}
  class="ai-device-selector-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.label != blank %}
    <label
      for="device-select-{{ ai_gen_id }}"
      class="ai-device-selector__label-{{ ai_gen_id }}"
    >
      {{ block.settings.label }}
      {% if block.settings.show_required %}
        <span aria-label="required">*</span>
      {% endif %}
    </label>
  {% endif %}

  <div class="ai-device-selector__wrapper-{{ ai_gen_id }}">
    <select
      id="device-select-{{ ai_gen_id }}"
      class="ai-device-selector__select-{{ ai_gen_id }}"
      {% if block.settings.show_required %}required{% endif %}
      aria-label="{{ block.settings.label | default: 'Select your device' }}"
    >
      <option value="" disabled selected>{{ block.settings.placeholder }}</option>
      
      {% if block.settings.device_1 != blank %}
        <option value="{{ block.settings.device_1 }}">{{ block.settings.device_1 }}</option>
      {% endif %}
      
      {% if block.settings.device_2 != blank %}
        <option value="{{ block.settings.device_2 }}">{{ block.settings.device_2 }}</option>
      {% endif %}
      
      {% if block.settings.device_3 != blank %}
        <option value="{{ block.settings.device_3 }}">{{ block.settings.device_3 }}</option>
      {% endif %}
      
      {% if block.settings.device_4 != blank %}
        <option value="{{ block.settings.device_4 }}">{{ block.settings.device_4 }}</option>
      {% endif %}
      
      {% if block.settings.device_5 != blank %}
        <option value="{{ block.settings.device_5 }}">{{ block.settings.device_5 }}</option>
      {% endif %}
      
      {% if block.settings.device_6 != blank %}
        <option value="{{ block.settings.device_6 }}">{{ block.settings.device_6 }}</option>
      {% endif %}
      
      {% if block.settings.device_7 != blank %}
        <option value="{{ block.settings.device_7 }}">{{ block.settings.device_7 }}</option>
      {% endif %}
      
      {% if block.settings.device_8 != blank %}
        <option value="{{ block.settings.device_8 }}">{{ block.settings.device_8 }}</option>
      {% endif %}
      
      {% if block.settings.device_9 != blank %}
        <option value="{{ block.settings.device_9 }}">{{ block.settings.device_9 }}</option>
      {% endif %}
      
      {% if block.settings.device_10 != blank %}
        <option value="{{ block.settings.device_10 }}">{{ block.settings.device_10 }}</option>
      {% endif %}
    </select>

    <svg
      class="ai-device-selector__icon-{{ ai_gen_id }}"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M5 7.5L10 12.5L15 7.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>

  {% if block.settings.show_selected_value %}
    <div
      class="ai-device-selector__selected-value-{{ ai_gen_id }}"
      id="selected-device-{{ ai_gen_id }}"
      role="status"
      aria-live="polite"
    >
      <span class="ai-device-selector__selected-label-{{ ai_gen_id }}">Selected device:</span>
      <span id="selected-device-text-{{ ai_gen_id }}"></span>
    </div>
  {% endif %}
</device-selector-{{ ai_gen_id }}>

<script>
  (function() {
    class DeviceSelector{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.select = this.querySelector('#device-select-{{ ai_gen_id }}');
        this.selectedValueContainer = this.querySelector('#selected-device-{{ ai_gen_id }}');
        this.selectedValueText = this.querySelector('#selected-device-text-{{ ai_gen_id }}');
        
        if (this.select) {
          this.select.addEventListener('change', this.handleChange.bind(this));
        }
      }

      handleChange(event) {
        const selectedValue = event.target.value;
        
        if (this.selectedValueContainer && this.selectedValueText) {
          if (selectedValue) {
            this.selectedValueText.textContent = selectedValue;
            this.selectedValueContainer.classList.add('active');
          } else {
            this.selectedValueContainer.classList.remove('active');
          }
        }

        this.dispatchEvent(new CustomEvent('device-selected', {
          detail: { device: selectedValue },
          bubbles: true,
          composed: true
        }));
      }
    }

    customElements.define('device-selector-{{ ai_gen_id }}', DeviceSelector{{ ai_gen_id }});
  })();
</script>

